---
import { Icon } from 'astro-icon/components'

import { proyectos } from '@/data/portfolio'
import type { CaseChapter } from '@/models'
import { readableOn, toId } from '@/utils/color'
import { legacyToChapters } from '@/utils/caseStudy'

import Layout from '@/layouts/Layout.astro'
import BarNav from '@/components/BarNav.astro'
import Footer from '@/components/Footer.astro'
import CaseBlock from '@/components/CaseStudy/CaseBlock.astro'
import Media from '@/components/CaseStudy/Media.astro'
import Invitacion from '@/components/invitacion.astro'

export async function getStaticPaths() {
  return proyectos.map(proyecto => ({ params: { slug: proyecto.slug } }))
}

const { slug } = Astro.params
const index = proyectos.findIndex(p => p.slug === slug)
const proyecto = proyectos[index]

if (!proyecto) {
  throw new Error(`No existe el proyecto "${slug}"`)
}

const {
  nameProject,
  date,
  coverImage,
  linkFigma,
  linkWebsite,
  shortDescription,
  descriptionProject,
  objectiveBusiness,
  objectiveUser,
  tags,
  details,
  brand,
  role,
  roleSummary,
  tools,
  challenge,
  learnings,
  nextSteps,
} = proyecto

// ── Acento de la marca ─────────────────────────────────────────────
const accent = brand?.primary ?? '#2B2A29'
const accentStyle = [
  `--cs-accent:${accent}`,
  `--cs-accent-contrast:${readableOn(accent)}`,
  brand?.surface ? `--cs-stage:${brand.surface}` : '',
  brand?.headingFont ? `--cs-heading-font:'${brand.headingFont}'` : '',
]
  .filter(Boolean)
  .join(';')

// ── Ficha ──────────────────────────────────────────────────────────
const toList = (value?: string | string[]) => (value ? [value].flat() : [])
const projectType =
  details?.find(item => item.label === 'Tipo de proyecto')?.value ?? tags?.join(', ')
const projectRole = role ?? details?.find(item => item.label === 'My rol')?.value
const goals = [
  { title: 'Objetivo del negocio', items: toList(objectiveBusiness) },
  { title: 'Objetivo del usuario', items: toList(objectiveUser) },
].filter(goal => goal.items.length)

// ── Capítulos: los nuevos o, si no hay, los convertidos desde los campos antiguos ──
const rawChapters: CaseChapter[] = proyecto.chapters?.length
  ? proyecto.chapters
  : legacyToChapters(proyecto)

const chapters = rawChapters.map((chapter, i) => {
  const id = chapter.id ?? `capitulo-${i + 1}-${toId(chapter.title)}`
  return {
    ...chapter,
    id,
    number: i + 1,
    blocks: chapter.blocks.map(block => ({
      block,
      id: block.id ?? (block.title ? `${id}-${toId(block.title)}` : undefined),
    })),
  }
})

const learningList = toList(learnings)
// Menú de secciones: Resumen, cada capítulo y el epílogo
const shortTitle = (title: string) => (title.length > 26 ? `${title.slice(0, 24).trimEnd()}…` : title)
const nextStepList = toList(nextSteps)
const hasEpilogue = learningList.length > 0 || nextStepList.length > 0
const menu = [
  { id: 'resumen', label: 'Resumen' },
  ...chapters.map(c => ({ id: c.id, label: shortTitle(c.title), number: c.number })),
  ...(hasEpilogue ? [{ id: 'epilogo-seccion', label: 'Epílogo' }] : []),
]

// ── Siguiente proyecto ─────────────────────────────────────────────
const next = proyectos.length > 1 ? proyectos[(index + 1) % proyectos.length] : undefined
---

<Layout title={`${nameProject}: caso de estudio | Gabriela Ferrer`}>
  <BarNav active={false} />

  <div class="cs font-rethink" style={accentStyle}>
    {brand?.fontHref && <link rel="stylesheet" href={brand.fontHref} />}
    <p class="sr-only" aria-live="polite" data-copy-status></p>

    <main>
      <!-- ── Portada ── -->
      <header id="inicio-caso" class="cs-hero">
        <div class="cs-wrap flex flex-col gap-8">

          <h1 class:list={['cs-h1', !brand?.headingFont && 'font-fantabular']}>{nameProject}</h1>

          <div class="cs-hero-grid">
            <div
              class:list={['cs-stage', proyecto.coverFit === 'cover' && 'cs-stage--fill']}
              style={proyecto.coverPosition ? `--cs-cover-pos:${proyecto.coverPosition}` : undefined}
            >
              <Media
                image={{ src: coverImage, alt: `Portada del proyecto ${nameProject}` }}
                class="cs-stage-img"
                eager
              />
            </div>

            <div class="cs-hero-info">
              <p class="cs-lead">{shortDescription}</p>

              <dl class="cs-meta">
                {projectType && (
                  <div>
                    <dt>Tipo de proyecto</dt>
                    <dd>{projectType}</dd>
                  </div>
                )}
                <div>
                  <dt>Fecha</dt>
                  <dd>{date}</dd>
                </div>
                {projectRole && (
                  <div>
                    <dt>Rol</dt>
                    <dd>
                      <strong>{projectRole}</strong>
                      {roleSummary && <span class="cs-meta-note">{roleSummary}</span>}
                    </dd>
                  </div>
                )}
                {tools && tools.length > 0 && (
                  <div>
                    <dt>Herramientas</dt>
                    <dd>{tools.join(', ')}</dd>
                  </div>
                )}
              </dl>

              {(linkFigma || linkWebsite) && (
                <div class="flex flex-wrap gap-4">
                  {linkFigma && (
                    <a href={linkFigma} class="cs-cta" target="_blank" rel="noopener">
                      <Icon name="fa6-brands:figma" class="size-4" aria-hidden="true" />
                      Ver prototipo
                    </a>
                  )}
                  {linkWebsite && (
                    <a href={linkWebsite} class="cs-cta cs-cta-light" target="_blank" rel="noopener">
                      <Icon name="fa6-solid:arrow-up-right-from-square" class="size-4" aria-hidden="true" />
                      Visitar proyecto
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        </div>
      </header>

      <!-- ── Menú de secciones (se queda fijo al bajar) ── -->
      <nav class="cs-subnav" aria-label="Secciones del caso de estudio">
        <div class="cs-wrap cs-subnav-inner">
          <a href="#inicio-caso" class="cs-subnav-title">{nameProject}</a>
          <ol class="cs-subnav-list" data-subnav>
            {menu.map(item => (
              <li>
                <a href={`#${item.id}`} data-subnav-link>
                  {'number' in item && <span class="cs-subnav-num" aria-hidden="true">{item.number}</span>}
                  {item.label}
                </a>
              </li>
            ))}
          </ol>
        </div>
        <div class="cs-progress" aria-hidden="true"><span data-progress></span></div>
      </nav>

      <!-- ── Sinopsis, objetivos y desafío ── -->
      <section id="resumen" class="cs-wrap cs-split" aria-labelledby="sinopsis" data-subnav-target>
        <h2 id="sinopsis" class="cs-h2">Sinopsis</h2>
        <div class="cs-prose">
          {descriptionProject.split(/\n\s*\n/).map(p => <p>{p}</p>)}
        </div>
      </section>

      {
        goals.length > 0 && (
          <section class="cs-wrap cs-split" aria-labelledby="objetivos">
            <h2 id="objetivos" class="cs-h2">Objetivos</h2>
            <div class="grid gap-5 md:grid-cols-2">
              {goals.map(goal => (
                <div class="cs-card">
                  <h3 class="cs-h4">{goal.title}</h3>
                  {goal.items.length > 1 ? (
                    <ul class="cs-list">{goal.items.map(item => <li>{item}</li>)}</ul>
                  ) : (
                    <p class="cs-small">{goal.items[0]}</p>
                  )}
                </div>
              ))}
            </div>
          </section>
        )
      }

      {
        challenge && (
          <section class="cs-wrap cs-split" aria-labelledby="desafio">
            <h2 id="desafio" class="cs-h2">El desafío</h2>
            <p class="cs-statement">{challenge}</p>
          </section>
        )
      }

      <!-- ── Índice de capítulos ── -->
      {
        chapters.length > 1 && (
          <nav class="cs-wrap cs-toc" aria-labelledby="capitulos">
            <h2 id="capitulos" class="cs-h2">Los capítulos</h2>
            <ol class="cs-toc-grid">
              {chapters.map(chapter => (
                <li class="cs-toc-item">
                  <span class="cs-num" aria-hidden="true">{chapter.number}</span>
                  <a href={`#${chapter.id}`} class="cs-toc-title">{chapter.title}</a>
                  {chapter.blocks.some(b => b.block.title) && (
                    <ul class="cs-toc-sub">
                      {chapter.blocks
                        .filter(b => b.block.title && b.id)
                        .map(b => (
                          <li><a href={`#${b.id}`}>{b.block.title}</a></li>
                        ))}
                    </ul>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <!-- ── Capítulos ── -->
      {
        chapters.map(chapter => (
          <section id={chapter.id} class="cs-wrap cs-chapter" aria-labelledby={`${chapter.id}-titulo`} data-subnav-target>
            <header class="cs-chapter-head">
              <span class="cs-num" aria-hidden="true">{chapter.number}</span>
              <h2 id={`${chapter.id}-titulo`} class="cs-h2">{chapter.title}</h2>
              {chapter.intro && <p class="cs-lead cs-chapter-intro">{chapter.intro}</p>}
            </header>
            <div class="cs-chapter-body">
              {chapter.blocks.map(({ block, id }) => <CaseBlock block={block} id={id} />)}
            </div>
          </section>
        ))
      }

      <!-- ── Epílogo ── -->
      {
        hasEpilogue && (
          <section id="epilogo-seccion" class="cs-wrap cs-chapter" aria-labelledby="epilogo" data-subnav-target>
            <header class="cs-chapter-head">
              <h2 id="epilogo" class="cs-h2">El epílogo</h2>
            </header>
            <div class="grid gap-5 md:grid-cols-2">
              {nextStepList.length > 0 && (
                <div class="cs-card">
                  <h3 class="cs-h4">Próximos pasos</h3>
                  <ul class="cs-list">{nextStepList.map(item => <li>{item}</li>)}</ul>
                </div>
              )}
              {learningList.length > 0 && (
                <div class="cs-card">
                  <h3 class="cs-h4">Lo que aprendí</h3>
                  <ul class="cs-list">{learningList.map(item => <li>{item}</li>)}</ul>
                </div>
              )}
            </div>
          </section>
        )
      }

      <!-- ── Siguiente caso ── -->
      {
        next && (
          <aside class="cs-wrap cs-next-wrap" aria-label="Siguiente caso de estudio">
            <a href={`/proyectos/${next.slug}`} class="cs-next">
              <div class="cs-next-media">
                <Media image={{ src: next.coverImage, alt: '' }} class="cs-next-img" />
              </div>
              <div class="flex flex-col gap-3 justify-center">
                <span class="cs-small cs-muted">Siguiente caso de estudio</span>
                <span class="cs-h2">{next.nameProject}</span>
                <span class="cs-body cs-muted">{next.shortDescription}</span>
                <span class="cs-next-link">
                  Ver caso de estudio
                  <Icon name="fa6-solid:arrow-right" class="size-3.5" aria-hidden="true" />
                </span>
              </div>
            </a>
          </aside>
        )
      }

    <Invitacion />
    </main>

    <button id="backToTop" type="button" class="cs-top" aria-label="Volver arriba">
      <Icon name="fa6-solid:arrow-up" class="size-4" aria-hidden="true" />
    </button>
  </div>
  
  <Footer />
</Layout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  // Barra de progreso y botón para volver arriba
  const bar = document.querySelector<HTMLElement>('[data-progress]')
  const toTop = document.getElementById('backToTop')
  let ticking = false

  const update = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight
    const progress = max > 0 ? window.scrollY / max : 0
    if (bar) bar.style.transform = `scaleX(${progress})`
    toTop?.classList.toggle('is-visible', window.scrollY > 700)
    ticking = false
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true
        requestAnimationFrame(update)
      }
    },
    { passive: true },
  )
  update()

  toTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' })
  })

  // Menú de secciones: marca la sección que se está leyendo
  const subnav = document.querySelector<HTMLElement>('[data-subnav]')
  const subnavLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-subnav-link]')]
  const targets = [...document.querySelectorAll<HTMLElement>('[data-subnav-target]')]

  const setActive = (id: string | null) => {
    subnavLinks.forEach(link => {
      const active = id !== null && link.hash === `#${id}`
      if (active) {
        link.setAttribute('aria-current', 'true')
        // En celular, mueve el menú para que la sección activa quede a la vista
        if (subnav) {
          const left = link.offsetLeft - subnav.clientWidth / 2 + link.clientWidth / 2
          subnav.scrollTo({ left, behavior: reduceMotion ? 'auto' : 'smooth' })
        }
      } else {
        link.removeAttribute('aria-current')
      }
    })
  }

  if (targets.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) setActive(entry.target.id)
        })
      },
      { rootMargin: '-40% 0px -55% 0px' },
    )
    targets.forEach(target => observer.observe(target))

    // Antes del resumen no hay ninguna sección activa
    const hero = document.getElementById('inicio-caso')
    if (hero) {
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting && entry.intersectionRatio > 0.4) setActive(null)
      }, { threshold: [0.4] }).observe(hero)
    }
  }

  // Comparar dos imágenes
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach(root => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-compare-button]')
    const items = root.querySelectorAll<HTMLElement>('[data-compare-item]')

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        const selected = button.dataset.compareButton
        buttons.forEach(b => b.setAttribute('aria-pressed', String(b === button)))
        items.forEach(item => {
          const active = item.dataset.compareItem === selected
          item.classList.toggle('is-active', active)
          item.setAttribute('aria-hidden', String(!active))
        })
      })
    })
  })

  // Copiar códigos de color
  const status = document.querySelector<HTMLElement>('[data-copy-status]')

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button => {
    button.addEventListener('click', async () => {
      const code = button.dataset.copy ?? ''
      try {
        await navigator.clipboard.writeText(code)
        button.classList.add('is-copied')
        if (status) status.textContent = `Código ${code} copiado`
        setTimeout(() => button.classList.remove('is-copied'), 1400)
      } catch {
        if (status) status.textContent = `No se pudo copiar. El código es ${code}`
      }
    })
  })
</script>

<style is:global>
  /* ── Tokens: neutros para que cada proyecto luzca su propia marca ── */
  .cs {
    /* Alto del header del sitio (BarNav) y del menú de secciones */
    --cs-header: var(--altura-header, 4rem);
    --cs-subnav-h: 3.5rem;
    --cs-offset: calc(var(--cs-header) + var(--cs-subnav-h) + 1.5rem);
    --cs-ink: #1f1e1d;
    --cs-muted: #5d5955;
    --cs-line: #e6e3de;
    --cs-surface: #f5f4f1;
    --cs-accent: #2b2a29;
    --cs-accent-contrast: #ffffff;
    --cs-stage: color-mix(in srgb, var(--cs-accent) 10%, #ffffff);
    color: var(--cs-ink);
    background: #ffffff;
  }

  /* ── Estructura ── */
  .cs-wrap {
    width: min(1120px, 100% - 2.5rem);
    margin-inline: auto;
  }
  /* Portada con el fondo de puntos del portafolio */
  .cs-hero {
    padding-block: calc(var(--cs-header) + 3rem) 4.5rem;
    background-color: #ffffff;
    background-image: radial-gradient(color-mix(in srgb, var(--cs-accent) 28%, transparent) 1px, transparent 1.2px);
    background-size: 18px 18px;
  }
  .cs-hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .cs-hero-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 4rem;
    }
  }
  .cs-hero-info {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 0.25rem;
  }
  .cs-split {
    scroll-margin-top: var(--cs-offset);
    display: grid;
    gap: 1.25rem;
    padding-block: 3rem;
    border-top: 1px solid var(--cs-line);
  }
  @media (min-width: 900px) {
    .cs-split {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 3rem;
    }
  }
  .cs-chapter {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-block: 4.5rem;
    border-top: 1px solid var(--cs-line);
    scroll-margin-top: var(--cs-offset);
  }
  .cs-chapter-head {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .cs-chapter-body {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
  .cs-block {
    scroll-margin-top: var(--cs-offset);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .cs-block-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* ── Tipografía ── */
  .cs-h1 {
    font-family: var(--cs-heading-font, inherit);
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 1.02;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .cs-h2 {
    font-family: var(--cs-heading-font, inherit);
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .cs-h3 {
    font-size: 1.35rem;
    line-height: 1.3;
    font-weight: 650;
  }
  .cs-h4 {
    font-size: 1.1rem;
    line-height: 1.35;
    font-weight: 650;
  }
  .cs-lead {
    max-width: 60ch;
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    line-height: 1.55;
    color: var(--cs-muted);
  }
  .cs-statement {
    max-width: 44ch;
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    line-height: 1.45;
    font-weight: 500;
  }
  .cs-body,
  .cs-prose {
    max-width: 68ch;
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .cs-prose {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cs-small {
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .cs-muted {
    color: var(--cs-muted);
  }

  /* ── Portada ── */
  .cs-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    font-weight: 600;
    color: var(--cs-muted);
  }
  .cs-back:hover {
    color: var(--cs-ink);
  }
  .cs-stage {
    display: grid;
    place-items: center;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    background: var(--cs-stage);
    border-radius: 6px;
    overflow: hidden;
  }
  .cs-stage-img {
    width: 100%;
    height: auto;
    border-radius: 12px;
  }
  /* Portada que llena un panel vertical, como un afiche */
  .cs-stage--fill {
    aspect-ratio: 4 / 5;
    padding: 0;
  }
  .cs-stage--fill .cs-stage-img {
    height: 100%;
    object-fit: cover;
    object-position: var(--cs-cover-pos, center);
    border-radius: 0;
  }
  .cs-meta {
    display: flex;
    flex-direction: column;
  }
  .cs-meta > div {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--cs-ink);
  }
  .cs-meta > div:last-child {
    border-bottom: 0;
  }
  .cs-meta dt {
    font-weight: 700;
    font-size: 1.05rem;
  }
  .cs-meta dd {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    color: var(--cs-muted);
    line-height: 1.55;
  }
  .cs-meta dd strong {
    color: var(--cs-ink);
    font-weight: 600;
  }
  .cs-meta-note {
    font-size: 0.975rem;
  }

  /* ── Botón principal: el estilo del portafolio con el color de cada proyecto ── */
  .cs-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.5rem;
    border: 2px solid var(--cs-ink);
    border-radius: 999px;
    background: var(--cs-accent);
    color: var(--cs-accent-contrast);
    font-weight: 700;
    box-shadow: 4px 4px 0 var(--cs-ink);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .cs-cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--cs-ink);
  }
  .cs-cta:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--cs-ink);
  }
  .cs-cta-light {
    background: #ffffff;
    color: var(--cs-ink);
  }

  /* ── Índice de capítulos ── */
  .cs-toc {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-block: 3.5rem;
    border-top: 1px solid var(--cs-line);
  }
  .cs-toc-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }
  .cs-toc-item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.4rem;
    background: var(--cs-surface);
    border-radius: 20px;
  }
  .cs-toc-title {
    font-size: 1.15rem;
    font-weight: 650;
    line-height: 1.3;
  }
  .cs-toc-sub {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.95rem;
    color: var(--cs-muted);
  }
