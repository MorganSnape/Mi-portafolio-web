---
import { Image } from 'astro:assets'

import { proyectos } from '@/data/portfolio'

import Layout from '@/layouts/Layout.astro'
import Investigacion from '@/components/PaginaDinamica/Investigacion.astro'
import DefinicionProblema from '@/components/PaginaDinamica/DefinicionProblema.astro'
import Ideacion from '@/components/PaginaDinamica/Ideacion.astro'
import Diseño from '@/components/PaginaDinamica/Diseño.astro'
import { Icon } from 'astro-icon/components'
import Button from '@/components/Button.astro'
import BarNav from '@/components/BarNav.astro'

import Estrella from '@/assets/estrella.svg'
import Footer from '@/components/Footer.astro'

export async function getStaticPaths() {
  return proyectos.flatMap(proyecto => {
    return {
      params: { slug: proyecto.slug },
    }
  })
}

const { slug } = Astro.params
const proyecto = proyectos.find(proyecto => proyecto.slug === slug)

if (!proyecto) {
  throw new Error('No existe el proyecto')
}

const {
  nameProject,
  date,
  brandDescription,
  coverImage,
  linkFigma,
  projectImagesList,
  linkWebsite,
  shortDescription,
  descriptionProject,
  objectiveBusiness,
  objectiveUser,
  testing,
  research,
  problemDefinition,
  ideation,
  visualDesign,
  tags,
  details,
} = proyecto
---

<Layout title=`Este es el proyecto ${nameProject}`>
  <BarNav active={false} />
  <aside
    id="section-nav"
    class="fixed right-4 top-1/2 z-40 hidden -translate-y-1/2 lg:flex lg:flex-col lg:items-end lg:gap-3"
    aria-label="Navegación por secciones"
  >
    <div class="rounded-full border border-black-secondary/20 bg-white/90 p-2 shadow-[4px_4px_0px_#141414] backdrop-blur">
      <div class="relative h-40 w-2 overflow-hidden rounded-full bg-black-secondary/15">
        <div
          id="nav-progress-fill"
          class="absolute bottom-0 left-0 w-full rounded-full bg-primary transition-all duration-300"
          style="height: 0%;"
        />
      </div>
    </div>
    <nav class="max-w-[220px] rounded-2xl border border-black-secondary/10 bg-white/90 p-3 shadow-[4px_4px_0px_#141414] backdrop-blur">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.25em] text-black-secondary/70">
        Secciones
      </p>
      <ul id="section-nav-list" class="flex flex-col gap-2"></ul>
    </nav>
  </aside>

  <main class="flex flex-col items-center gap-20 py-14">
    <button
      id="backToTop"
      type="button"
      aria-label="Scroll projects left"
      class="fixed z-50 bottom-10 left-1/2 -translate-x-1/2 primaryButton bg-white rounded-full text-black p-3 cursor-pointer opacity-60 hover:opacity-1000"
    >
      <Icon name="fa6-solid:arrow-up" height={20} width={20} />
    </button>
    <div
      class="fixed bottom-10 right-4 md:right-10 z-50 flex flex-col md:flex-row gap-4"
    >
      {
        linkFigma && (
          <Button href={linkFigma} text="Ver Figma" style="solid" typeIcon>
            <Icon name="fa6-brands:figma" height={20} width={20} />
          </Button>
        )
      }
      {
        linkWebsite && (
          <Button href={linkWebsite} text="Ver Pagina" style="solid" typeIcon>
            <Icon name="fa6-solid:earth-americas" height={20} width={20} />
          </Button>
        )
      }
    </div>
    <section id="inicio" class="flex flex-col items-center w-full pt-20 border-y-2 border-black-secondary/10">
      <div
        class="flex flex-col gap-4 items-start py-3 max-w-[1280px] w-full px-4 md:px-12 lg:px-0"
      >
        <h1 class="titleH3 font-bold font-fantabular">
          {nameProject}
          <span class="text-primary">
            - {details?.find(item => item.label === 'My rol')?.value}
          </span>
        </h1>
        <p class="text-base md:text-lg leading-tight">
          {shortDescription}
        </p>
        <ul
          class="w-full text-black text-sm md:text-base flex flex-wrap md:flex-row items-center gap-4 py-2"
        >
          <li class="flex flex-row gap-3 items-center">
            <div
              class="h-10 w-10 rounded-full flex justify-center bg-primary overflow-hidden bg-cover bg-center border-2 border-primary"
            >
              <img
                src="/images/Foto.png"
                alt="Foto de Gabriela Ferrer usando un sueter rosa y sonriendo."
                class="w-full h-full object-cover object-top"
              />
            </div>
            <p class="font-semibold">Gabriela Ferrer</p>
          </li>
          <li class="mx-6">
            <p class="text-black text-base font-semibold">
              {date}
            </p>
          </li>
          {
            tags &&
              tags.map(tag => (
                <li class="bg-secondary text-black py-0.5 px-2 md:px-4 w-fit text-sm font-semibold border-2 border-black">
                  {tag}
                </li>
              ))
          }
        </ul>
        <ul
          class="w-full grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-5 gap-4 items-start"
        >
          {
            details?.map(detail => (
              <li class="flex flex-col justify-center gap-2 text-center">
                <div class="flex flex-row justify-center items-center gap-2 font-semibold">
                  <Icon name={detail.icon} class="text-lg md:text-xl" />
                  {detail.label}
                </div>
                <p class="text-base md:text-lg">{detail.value}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
    <div
      class="max-w-[1280px] w-full px-4 md:px-12 lg:px-0 flex flex-col gap-20 mb-8"
    >
      <section id="acerca" class="flex flex-col gap-12">
        <Image
          src={coverImage}
          alt={`Portada del proyecto ${nameProject}`}
          class="h-[200px] md:h-[400px] w-full object-cover object-center rounded-lg border-y-2 border-black-secondary/10"
          width={coverImage.width}
          height={coverImage.height}
        />

        {
          brandDescription && (
            <p class="italic text-base md:text-lg border-l-8 border-primary pl-4">
              {brandDescription}
            </p>
          )
        }
        <div
          class="grid grid-cols-1 md:grid-cols-[410px_1fr] gap-8 md:gap-12 items-center"
        >
          <h2 class="titleProyecto">
            Contexto del <br /> proyecto
          </h2>
          <p class="text-balance text-base md:text-lg whitespace-pre-wrap">
            {descriptionProject}
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-40">
          <div class="flex flex-col gap-4">
            <div class="flex flex-row gap-4 items-center">
              <Estrella class="h-8 w-8" />
              <h3 class="subtituloProyecto">Objetivo del negocio</h3>
            </div>
            {
              Array.isArray(objectiveBusiness) ? (
                <ul>
                  {objectiveBusiness.map(item => (
                    <li class="list-disc list-outside ml-5 text-base md:text-lg">
                      {item}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-balance text-base md:text-lg">
                  {objectiveBusiness}
                </p>
              )
            }
          </div>
          <div class="flex flex-col gap-4">
            <div class="flex flex-row gap-4 items-center">
              <Estrella class="h-8 w-8" />
              <h3 class="subtituloProyecto">Objetivo del usuario</h3>
            </div>
            {
              Array.isArray(objectiveUser) ? (
                <ul>
                  {objectiveUser.map(item => (
                    <li class="list-disc list-outside ml-5 text-base md:text-lg">
                      {item}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-balance text-base md:text-lg">{objectiveUser}</p>
              )
            }
          </div>
        </div>
      </section>

      {
        projectImagesList && (
          <div class="flex flex-col gap-0 w-full mx-auto bg-black-secondary/90">
            {projectImagesList?.map((img: any) => (
              <Image
                src={img}
                alt={`Imagen del proyecto ${nameProject}`}
                class="shadow-xl"
              />
            ))}
          </div>
        )
      }

      {research && <Investigacion research={research} />}
      {
        problemDefinition && (
          <DefinicionProblema problemDefinition={problemDefinition} />
        )
      }
      {ideation && <Ideacion ideation={ideation} />}
      {
        testing && (
          <div class="flex flex-col gap-12">
            <h2 class="titleProyecto">Pruebas</h2>
            <p>{testing.summary}</p>
          </div>
        )
      }
    </div>
    {visualDesign && <Diseño visualDesign={visualDesign} />}
  </main>
  <Footer />
</Layout>

