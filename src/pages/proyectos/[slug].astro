---
import { Icon } from 'astro-icon/components'

import { proyectos } from '@/data/portfolio'
import type { CaseChapter, ProyectLink } from '@/models'
import { readableOn, toId } from '@/utils/color'
import { legacyToChapters } from '@/utils/caseStudy'

import Layout from '@/layouts/Layout.astro'
import BarNav from '@/components/BarNav.astro'
import Footer from '@/components/Footer.astro'
import CaseBlock from '@/components/CaseStudy/CaseBlock.astro'
import Media from '@/components/CaseStudy/Media.astro'
import Invitacion from '@/components/invitacion.astro'
import Etiqueta from '@/components/ui/Etiqueta.astro'

export async function getStaticPaths() {
  return proyectos.map(proyecto => ({ params: { slug: proyecto.slug } }))
}

const { slug } = Astro.params
const index = proyectos.findIndex(p => p.slug === slug)
const proyecto = proyectos[index]

if (!proyecto) {
  throw new Error(`No existe el proyecto "${slug}"`)
}

const {
  nameProject,
  headline,
  date,
  coverImage,
  linkFigma,
  linkWebsite,
  linkGit,
  links,
  shortDescription,
  descriptionProject,
  objectives,
  objectiveBusiness,
  objectiveUser,
  tags,
  details,
  brand,
  role,
  roleSummary,
  tools,
  credits,
  challenge,
  learnings,
  nextSteps,
} = proyecto

// Página que lista todos los proyectos (ajústala si tu ruta es otra)
const projectsHref = '/#proyectos-container'

// ── Colores de la marca del proyecto ───────────────────────────────
// primary: portada, menú activo, números y frases destacadas.
// secondary: botón principal (si no hay, el botón es negro).
// El color del texto encima de cada uno se calcula para que siempre se lea.
const INK = '#16140F'
const accent = brand?.primary ?? '#6A3587'
const accent2 = brand?.secondary ?? INK
const accentStyle = [
  `--cs-accent:${accent}`,
  `--cs-accent-contrast:${readableOn(accent)}`,
  `--cs-accent-2:${accent2}`,
  `--cs-accent-2-contrast:${readableOn(accent2)}`,
  brand?.surface ? `--cs-cover-bg:${brand.surface}` : '',
  brand?.headingFont ? `--cs-heading-font:'${brand.headingFont}'` : '',
]
  .filter(Boolean)
  .join(';')

// ── Ficha ──────────────────────────────────────────────────────────
const toList = (value?: string | string[]) => (value ? [value].flat().filter(Boolean) : [])

const projectKind =
  proyecto.projectType ?? details?.find(item => item.label === 'Tipo de proyecto')?.value
const projectRole = role ?? details?.find(item => item.label === 'My rol')?.value
const creditList = toList(credits)

type Fact = { label: string; values: string[]; note?: string; wide?: boolean }
const facts: Fact[] = []
if (projectKind) facts.push({ label: 'Tipo de proyecto', values: [projectKind] })
facts.push({ label: 'Fecha', values: [date] })
if (projectRole) facts.push({ label: 'Mi rol', values: [projectRole], note: roleSummary })
if (tools?.length) facts.push({ label: 'Herramientas', values: [tools.join(', ')] })
if (creditList.length) facts.push({ label: 'Créditos', values: creditList, wide: true })

// ── Botones de la portada (máximo 3) ───────────────────────────────
const linkIcons: Record<NonNullable<ProyectLink['kind']>, string> = {
  figma: 'fa6-brands:figma',
  behance: 'fa6-brands:behance',
  pdf: 'fa6-solid:file-arrow-down',
  website: 'fa6-solid:arrow-up-right-from-square',
  github: 'fa6-brands:github',
  video: 'fa6-solid:play',
}
const fallbackLinks: ProyectLink[] = [
  ...(linkFigma ? [{ label: 'Ver prototipo en Figma', href: linkFigma, kind: 'figma' as const }] : []),
  ...(linkWebsite ? [{ label: 'Visitar el sitio', href: linkWebsite, kind: 'website' as const }] : []),
  ...(linkGit ? [{ label: 'Ver código en GitHub', href: linkGit, kind: 'github' as const }] : []),
]
const sourceLinks = links?.length ? links : fallbackLinks
const hasPrimary = sourceLinks.some(link => link.primary)
const ctas = sourceLinks.slice(0, 3).map((link, i) => {
  const external = /^https?:\/\//.test(link.href)
  // Los enlaces externos y los PDF se abren en otra pestaña (y se avisa a los lectores de pantalla)
  const newTab = external || link.kind === 'pdf'
  return {
    ...link,
    newTab,
    primary: hasPrimary ? !!link.primary : i === 0,
    icon: linkIcons[link.kind ?? 'website'],
  }
})

// ── Objetivos ──────────────────────────────────────────────────────
const objectiveList = toList(objectives)
const goals = [
  { title: 'Del negocio', items: toList(objectiveBusiness) },
  { title: 'De la persona usuaria', items: toList(objectiveUser) },
].filter(goal => goal.items.length)
const hasGoals = objectiveList.length > 0 || goals.length > 0

// ── Capítulos: los nuevos o, si no hay, los convertidos desde los campos antiguos ──
const rawChapters: CaseChapter[] = proyecto.chapters?.length
  ? proyecto.chapters
  : legacyToChapters(proyecto)

const shortTitle = (title: string) => (title.length > 26 ? `${title.slice(0, 24).trimEnd()}…` : title)

const chapters = rawChapters.map((chapter, i) => {
  const id = chapter.id ?? `capitulo-${i + 1}-${toId(chapter.label ?? chapter.title)}`
  return {
    ...chapter,
    id,
    number: i + 1,
    menuLabel: chapter.label ?? shortTitle(chapter.title),
    blocks: chapter.blocks.map(block => ({
      block,
      id: block.id ?? (block.title ? `${id}-${toId(block.title)}` : undefined),
    })),
  }
})

const learningList = toList(learnings)
const nextStepList = toList(nextSteps)
const hasEpilogue = learningList.length > 0 || nextStepList.length > 0

// Menú de secciones: Resumen, cada capítulo y el epílogo
const menu = [
  { id: 'resumen', label: 'Resumen' },
  ...chapters.map(c => ({ id: c.id, label: c.menuLabel, number: c.number })),
  ...(hasEpilogue ? [{ id: 'epilogo-seccion', label: 'Epílogo' }] : []),
]

// ── Siguiente proyecto: su tarjeta lleva el color de su propia marca ──
const next = proyectos.length > 1 ? proyectos[(index + 1) % proyectos.length] : undefined
const nextAccent = next?.brand?.primary ?? '#6A3587'
const nextStyle = `--cs-next-accent:${nextAccent};--cs-next-contrast:${readableOn(nextAccent)}`
---

<Layout title={`${nameProject}: caso de estudio | Gabriela Ferrer`}>
  <BarNav active={false} />

  <div class="cs font-rethink" style={accentStyle}>
    {brand?.fontHref && <link rel="stylesheet" href={brand.fontHref} />}
    <p class="sr-only" aria-live="polite" data-copy-status></p>

    <main>
      <!-- ── Portada: fondo de puntos con el color de la marca ── -->
      <header id="inicio-caso" class="cs-hero">
        <div class="cs-wrap cs-hero-inner">
          <a href={projectsHref} class="cs-back">
            <Icon name="fa6-solid:arrow-left" class="size-3.5" aria-hidden="true" />
            Todos los proyectos
          </a>

          <div class="cs-hero-grid">
            <div
              class:list={['cs-stage', proyecto.coverFit === 'cover' && 'cs-stage--fill']}
              style={proyecto.coverPosition ? `--cs-cover-pos:${proyecto.coverPosition}` : undefined}
            >
              <Media
                image={{ src: coverImage, alt: `Portada del proyecto ${nameProject}` }}
                class="cs-stage-img"
                eager
              />
            </div>

            <div class="cs-hero-info">
              {(projectKind || tags?.length) && (
                <ul class="cs-chips" aria-label="Tipo de trabajo">
                  {projectKind && <li><Etiqueta color="blanco">{projectKind}</Etiqueta></li>}
                  {tags?.map(tag => <li><Etiqueta color="negro">{tag}</Etiqueta></li>)}
                </ul>
              )}

              {headline ? (
                <div class="cs-titles">
                  <p class="cs-eyebrow">{nameProject}</p>
                  <h1 class="cs-h1 cs-h1--headline">{headline}</h1>
                </div>
              ) : (
                <h1 class="cs-h1">{nameProject}</h1>
              )}

              <p class="cs-hero-lead">{shortDescription}</p>

              <dl class="cs-meta">
                {facts.map(fact => (
                  <div class:list={[fact.wide && 'cs-meta-wide']}>
                    <dt>{fact.label}</dt>
                    <dd>
                      {fact.values.length > 1 ? (
                        <ul class="cs-meta-list">{fact.values.map(v => <li>{v}</li>)}</ul>
                      ) : (
                        <strong>{fact.values[0]}</strong>
                      )}
                      {fact.note && <span class="cs-meta-note">{fact.note}</span>}
                    </dd>
                  </div>
                ))}
              </dl>

              {ctas.length > 0 && (
                <div class="cs-ctas">
                  {ctas.map(cta => (
                    <a
                      href={cta.href}
                      class:list={['cs-cta efecto-presionar', !cta.primary && 'cs-cta-light']}
                      target={cta.newTab ? '_blank' : undefined}
                      rel={cta.newTab ? 'noopener' : undefined}
                    >
                      <Icon name={cta.icon} class="size-4" aria-hidden="true" />
                      <span>
                        {cta.label}
                        {cta.note && <span class="cs-cta-note"> ({cta.note})</span>}
                      </span>
                      {cta.newTab && <span class="sr-only">(se abre en una pestaña nueva)</span>}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      </header>

      <!-- ── Menú de secciones (se queda fijo al bajar) ── -->
      <nav class="cs-subnav" aria-label="Secciones del caso de estudio">
        <div class="cs-wrap cs-subnav-inner">
          <a href="#inicio-caso" class="cs-subnav-title">{nameProject}</a>
          <ol class="cs-subnav-list" data-subnav>
            {menu.map(item => (
              <li>
                <a href={`#${item.id}`} data-subnav-link>
                  {'number' in item && <span class="cs-subnav-num" aria-hidden="true">{item.number}</span>}
                  {item.label}
                </a>
              </li>
            ))}
          </ol>
        </div>
        <div class="cs-progress" aria-hidden="true"><span data-progress></span></div>
      </nav>

      <!-- ── Resumen: sinopsis, desafío y objetivos ── -->
      <section id="resumen" class="cs-section" aria-labelledby="resumen-titulo" data-subnav-target>
        <div class="cs-wrap cs-section-inner">
          <p id="resumen-titulo" class="cs-kicker"><Etiqueta color="negro" mayusculas>Resumen</Etiqueta></p>

          <div class="cs-summary">
            <div class="cs-summary-main">
              <h2 class="cs-h3">Sinopsis</h2>
              <div class="cs-prose cs-prose--big">
                {descriptionProject.split(/\n\s*\n/).map(p => <p>{p}</p>)}
              </div>
            </div>

            {challenge && (
              <div class="cs-challenge">
                <h2 class="cs-h3">El desafío</h2>
                <p>{challenge}</p>
              </div>
            )}
          </div>

          {hasGoals && (
            <div class="cs-goals">
              <h2 class="cs-h3">Objetivos</h2>
              <ul class="cs-goal-grid">
                {objectiveList.map((item, i) => (
                  <li class="cs-card cs-card--raised">
                    <span class="cs-step" aria-hidden="true">{i + 1}</span>
                    <p class="cs-goal-text">{item}</p>
                  </li>
                ))}
                {goals.map(goal => (
                  <li class="cs-card cs-card--raised">
                    <span class="cs-tag">{goal.title}</span>
                    {goal.items.length > 1 ? (
                      <ul class="cs-list">{goal.items.map(item => <li>{item}</li>)}</ul>
                    ) : (
                      <p class="cs-goal-text">{goal.items[0]}</p>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>

      <!-- ── Capítulos: la etiqueta dice el tema, el título dice la conclusión ── -->
      {
        chapters.map(chapter => (
          <section
            id={chapter.id}
            class:list={['cs-section', chapter.tinted && 'cs-section--tinted']}
            aria-labelledby={`${chapter.id}-titulo`}
            data-subnav-target
          >
            <div class="cs-wrap cs-section-inner">
              <header class="cs-chapter-head">
                <p class="cs-kicker">
                  <span class="cs-num" aria-hidden="true">{chapter.number}</span>
                  {chapter.label && <Etiqueta color="negro" mayusculas>{chapter.label}</Etiqueta>}
                </p>
                <h2 id={`${chapter.id}-titulo`} class="cs-h2">{chapter.title}</h2>
                {chapter.intro && <p class="cs-lead">{chapter.intro}</p>}
              </header>
              <div class="cs-chapter-body">
                {chapter.blocks.map(({ block, id }) => <CaseBlock block={block} id={id} />)}
              </div>
            </div>
          </section>
        ))
      }

      <!-- ── Epílogo ── -->
      {
        hasEpilogue && (
          <section id="epilogo-seccion" class="cs-section" aria-labelledby="epilogo" data-subnav-target>
            <div class="cs-wrap cs-section-inner">
              <header class="cs-chapter-head">
                <p class="cs-kicker"><Etiqueta color="negro" mayusculas>Epílogo</Etiqueta></p>
                <h2 id="epilogo" class="cs-h2">Lo que me llevo de este proyecto</h2>
              </header>
              <div class="cs-epilogue">
                {learningList.length > 0 && (
                  <div class="cs-card cs-card--raised">
                    <h3 class="cs-h4">Lo que aprendí</h3>
                    {learningList.length > 1 ? (
                      <ul class="cs-list">{learningList.map(item => <li>{item}</li>)}</ul>
                    ) : (
                      <p class="cs-body">{learningList[0]}</p>
                    )}
                  </div>
                )}
                {nextStepList.length > 0 && (
                  <div class="cs-card cs-card--raised">
                    <h3 class="cs-h4">Próximos pasos</h3>
                    {nextStepList.length > 1 ? (
                      <ul class="cs-list">{nextStepList.map(item => <li>{item}</li>)}</ul>
                    ) : (
                      <p class="cs-body">{nextStepList[0]}</p>
                    )}
                  </div>
                )}
              </div>
            </div>
          </section>
        )
      }

      <!-- ── Final: fondo oscuro de puntos, igual que la página principal ── -->
      <div class="cs-final">
      <!-- Siguiente caso: la tarjeta lleva el color de su marca -->
      {
        next && (
          <aside class="cs-next-band" aria-label="Siguiente caso de estudio">
            <div class="cs-wrap">
              <a href={`/proyectos/${next.slug}`} class="cs-next efecto-hundir shadow-(color:--cs-next-accent)" style={nextStyle}>
                <div class="cs-next-media">
                  <Media image={{ src: next.coverImage, alt: '' }} class="cs-next-img" />
                </div>
                <div class="cs-next-text">
                  <span class="cs-tag">Siguiente caso de estudio</span>
                  <span class="cs-h3" style={next.brand?.headingFont ? `--cs-heading-font:'${next.brand.headingFont}'` : undefined}>{next.nameProject}</span>
                  <span class="cs-body cs-muted cs-next-desc">{next.shortDescription}</span>
                  <span class="cs-next-link">
                    Ver caso de estudio
                    <Icon name="fa6-solid:arrow-right" class="size-3.5" aria-hidden="true" />
                  </span>
                </div>
              </a>
            </div>
          </aside>
        )
      }

      <!-- Cierre fuera de la caja: mismo ancho que las secciones -->
      <div class="cs-wrap">
        <Invitacion />
      </div>
      </div>
    </main>

    <button id="backToTop" type="button" class="cs-top efecto-presionar" aria-label="Volver arriba">
      <Icon name="fa6-solid:arrow-up" class="size-4" aria-hidden="true" />
    </button>
  </div>

  <Footer />
</Layout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  // Barra de progreso y botón para volver arriba
  const bar = document.querySelector<HTMLElement>('[data-progress]')
  const toTop = document.getElementById('backToTop')
  let ticking = false

  const update = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight
    const progress = max > 0 ? window.scrollY / max : 0
    if (bar) bar.style.transform = `scaleX(${progress})`
    toTop?.classList.toggle('is-visible', window.scrollY > 700)
    ticking = false
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true
        requestAnimationFrame(update)
      }
    },
    { passive: true },
  )
  update()

  toTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' })
  })

  // Menú de secciones: marca la sección que se está leyendo
  const subnav = document.querySelector<HTMLElement>('[data-subnav]')
  const subnavLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-subnav-link]')]
  const targets = [...document.querySelectorAll<HTMLElement>('[data-subnav-target]')]

  const setActive = (id: string | null) => {
    subnavLinks.forEach(link => {
      const active = id !== null && link.hash === `#${id}`
      if (active) {
        link.setAttribute('aria-current', 'true')
        // En celular, mueve el menú para que la sección activa quede a la vista
        if (subnav) {
          const left = link.offsetLeft - subnav.clientWidth / 2 + link.clientWidth / 2
          subnav.scrollTo({ left, behavior: reduceMotion ? 'auto' : 'smooth' })
        }
      } else {
        link.removeAttribute('aria-current')
      }
    })
  }

  if (targets.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) setActive(entry.target.id)
        })
      },
      { rootMargin: '-40% 0px -55% 0px' },
    )
    targets.forEach(target => observer.observe(target))

    // Antes del resumen no hay ninguna sección activa
    const hero = document.getElementById('inicio-caso')
    if (hero) {
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting && entry.intersectionRatio > 0.4) setActive(null)
      }, { threshold: [0.4] }).observe(hero)
    }
  }

  // Comparar dos imágenes
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach(root => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-compare-button]')
    const items = root.querySelectorAll<HTMLElement>('[data-compare-item]')

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        const selected = button.dataset.compareButton
        buttons.forEach(b => b.setAttribute('aria-pressed', String(b === button)))
        items.forEach(item => {
          const active = item.dataset.compareItem === selected
          item.classList.toggle('is-active', active)
          item.setAttribute('aria-hidden', String(!active))
        })
      })
    })
  })

  // Copiar códigos de color
  const status = document.querySelector<HTMLElement>('[data-copy-status]')

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button => {
    button.addEventListener('click', async () => {
      const code = button.dataset.copy ?? ''
      try {
        await navigator.clipboard.writeText(code)
        button.classList.add('is-copied')
        if (status) status.textContent = `Código ${code} copiado`
        setTimeout(() => button.classList.remove('is-copied'), 1400)
      } catch {
        if (status) status.textContent = `No se pudo copiar. El código es ${code}`
      }
    })
  })
</script>

<style is:global>
  /* ═══ PLANTILLA DE CASO DE ESTUDIO ═══════════════════════════════════════
     Dos capas:
     1. Estructura del portafolio (fija): bordes, radios, sombras duras, escala
        de texto, anchos y fondos salen de global.css (--radius-*, --shadow-*,
        --text-*, --container-*, --hundir, fondo.svg / fondoDos.svg).
     2. Identidad de cada proyecto (variable): solo el color y la tipografía de
        títulos. Se inyectan en style desde brand (primary, secondary, surface,
        headingFont). Si el proyecto no trae marca, se usan los de la marca
        personal (morado + Fantabular).
     No pongas medidas sueltas aquí: si hace falta una nueva, va en global.css. */
  .cs {
    --cs-header: var(--altura-header, 4rem);
    --cs-header-offset: var(--cs-header);
    --cs-subnav-h: 3.75rem;
    --cs-offset: calc(var(--cs-header-offset) + var(--cs-subnav-h) + 1.5rem);
    /* Tokens del sistema */
    --cs-ink: var(--color-black);
    --cs-muted: var(--color-black-secondary);
    --cs-paper: var(--color-white-cream);
    --cs-border: 2px solid var(--cs-ink);
    --cs-shadow: var(--shadow-dura);
    --cs-shadow-lg: var(--shadow-dura-lg);
    --cs-radius: var(--radius-ventana);
    /* Identidad del proyecto (se sobrescriben desde brand) */
    --cs-accent: var(--color-primary);
    --cs-accent-contrast: #ffffff;
    --cs-accent-2: var(--cs-ink);
    --cs-accent-2-contrast: #ffffff;
    --cs-cover-bg: var(--cs-paper);
    /* Tono claro de la marca para capítulos destacados y fondos de imagen */
    --cs-stage: color-mix(in srgb, var(--cs-accent) 14%, var(--cs-paper));
    color: var(--cs-ink);
    background: var(--cs-paper) url(/fondo.svg);
    background-size: 30px;
  }
  @media (min-width: 768px) {
    .cs {
      --cs-shadow: var(--shadow-dura-lg);
      --cs-shadow-lg: var(--shadow-dura-xl);
    }
  }
  html.header-hidden .cs {
    --cs-header-offset: 0px;
  }

  /* ── Estructura: mismo ancho que la página principal ── */
  .cs-wrap {
    width: min(var(--container-sitio), 100% - 2rem);
    margin-inline: auto;
  }
  @media (min-width: 640px) {
    .cs-wrap { width: min(var(--container-sitio), 100% - 6rem); }
  }
  @media (min-width: 1024px) {
    .cs-wrap { width: min(var(--container-sitio), 91.6667%); }
  }
  .cs-section {
    scroll-margin-top: var(--cs-offset);
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }
  .cs-section + .cs-section {
    border-top: var(--cs-border);
  }
  .cs-section--tinted {
    background: var(--cs-stage);
  }
  .cs-section-inner { display: flex; flex-direction: column; gap: 2.5rem; }
  .cs-chapter-head { display: flex; flex-direction: column; gap: 1rem; }
  .cs-chapter-body { display: flex; flex-direction: column; gap: 4rem; }
  .cs-block { scroll-margin-top: var(--cs-offset); display: flex; flex-direction: column; gap: 1.25rem; }
  .cs-block-head { display: flex; flex-direction: column; gap: 0.5rem; }

  /* ── Tipografía: roles de título de global.css con la fuente de la marca ── */
  .cs-h1,
  .cs-h1--headline,
  .cs-h2,
  .cs-h3,
  .cs-h4,
  .cs-quote,
  .cs-stat,
  .cs-subnav-title {
    font-family: var(--cs-heading-font, var(--font-fantabular));
    text-wrap: balance;
  }
  .cs-h1 { font-size: var(--text-display); line-height: 0.9; font-weight: 900; } /* titulo-portada */
