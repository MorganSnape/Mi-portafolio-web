---
import { Image } from 'astro:assets'

import { proyectos } from '@/data/portfolio'

import Layout from '@/layouts/Layout.astro'
import Investigacion from '@/components/PaginaDinamica/Investigacion.astro'
import DefinicionProblema from '@/components/PaginaDinamica/DefinicionProblema.astro'
import Ideacion from '@/components/PaginaDinamica/Ideacion.astro'
import Diseño from '@/components/PaginaDinamica/Diseño.astro'
import { Icon } from 'astro-icon/components'
import Button from '@/components/Button.astro'
import BarNav from '@/components/BarNav.astro'

import Estrella from '@/assets/estrella.svg'
import Footer from '@/components/Footer.astro'

export async function getStaticPaths() {
  return proyectos.flatMap(proyecto => {
    return {
      params: { slug: proyecto.slug },
    }
  })
}

const { slug } = Astro.params
const proyecto = proyectos.find(proyecto => proyecto.slug === slug)

if (!proyecto) {
  throw new Error('No existe el proyecto')
}

const {
  nameProject,
  date,
  brandDescription,
  coverImage,
  linkFigma,
  projectImagesList,
  linkWebsite,
  shortDescription,
  descriptionProject,
  objectiveBusiness,
  objectiveUser,
  testing,
  research,
  problemDefinition,
  ideation,
  visualDesign,
  tags,
  details,
} = proyecto
---

<Layout title=`Este es el proyecto ${nameProject}`>
  <BarNav active={false} />

  <main class="flex flex-col items-center gap-20 pt-14">
    <button
      id="backToTop"
      type="button"
      aria-label="Ir al inicio"
      class="fixed z-50 bottom-0 right-2 -translate-x-1/2 primaryButton bg-white rounded-t-2xl text-black p-3 cursor-pointer opacity-60 hover:opacity-100 gap-2"
    >
      <Icon name="fa6-solid:arrow-up" height={20} width={20} aria-hidden="true" />
      Ir al inicio
    </button>
    <section id="inicio" class="w-full">
      <div
        class="w-full lg:w-4/5 mx-auto max-w-[1280px] flex flex-col gap-10 px-4 py-12 md:px-12 md:py-16 lg:px-0"
      >
        <h1
          class="font-fantabular italic text-3xl font-medium leading-none md:text-5xl"
        >
          {nameProject}
        </h1>

        <div
          class="grid items-center gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] md:gap-14"
        >
          <div
            class="flex min-h-[280px] items-center justify-center overflow-hidden md:min-h-[460px]"
          >
            <Image
              src={coverImage}
              alt={`Portada del proyecto ${nameProject}`}
              class="h-full max-h-[520px] w-full object-contain"
              width={coverImage.width}
              height={coverImage.height}
            />
          </div>

          <div class="flex flex-col gap-8">
            <p class="max-w-2xl">
              {shortDescription}
            </p>
            <div class="flex flex-wrap gap-3">
              {
                tags?.map(tag => (
                  <span class="border-2 border-black bg-secondary px-3 py-1 text-sm font-semibold text-black">
                    {tag}
                  </span>
                ))
              }
            </div>

            <dl class="flex flex-col">
              <div class="border-b border-black-secondary/50 py-4">
                <dt class="font-bold">Tipo de proyecto</dt>
                <dd class="mt-1">
                  {
                    details?.find(item => item.label === 'Tipo de proyecto')
                      ?.value ?? tags?.join(' · ')
                  }
                </dd>
              </div>
              <div class="border-b border-black-secondary/50 py-4">
                <dt class="font-bold">Fecha</dt>
                <dd class="mt-1">{date}</dd>
              </div>
              <div class="border-b border-black-secondary/50 py-4">
                <dt class="font-bold">Rol</dt>
                <dd class="mt-1">
                  {details?.find(item => item.label === 'My rol')?.value}
                </dd>
              </div>
            </dl>

            {
              (linkFigma || linkWebsite) && (
                <div class="flex flex-wrap gap-4">
                  {linkFigma && (
                    <Button
                      href={linkFigma}
                      text="Ver prototipo"
                      style="solid"
                      typeIcon
                    >
                      <Icon name="fa6-brands:figma" height={18} width={18} />
                    </Button>
                  )}
                  {linkWebsite && (
                    <Button
                      href={linkWebsite}
                      text="Visitar proyecto"
                      style="solid"
                      typeIcon
                    >
                      <Icon
                        name="fa6-solid:arrow-up-right-from-square"
                        height={18}
                        width={18}
                      />
                    </Button>
                  )}
                </div>
              )
            }
          </div>
        </div>
      </div>
    </section>
    <div class="bg-tag w-full">
      <div
        class="w-full lg:w-4/5 mx-auto max-w-[1280px] px-4 md:px-12 lg:px-0 flex flex-col gap-8 my-8"
      >
        <h2 class="titleProyecto">Sinopsis</h2>
        <p class="text-balance text-base md:text-lg">
          {descriptionProject}
        </p>
      </div>
    </div>

    <div
      class="w-full lg:w-4/5 mx-auto max-w-[1280px] px-4 md:px-12 lg:px-0 flex flex-col gap-20 mb-8"
    >
      <section id="acerca" class="flex flex-col gap-12">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-40">
          <div class="flex flex-col gap-4">
            <div class="flex flex-row gap-4 items-center">
              <Estrella class="h-8 w-8" />
              <h3 class="subtituloProyecto">Objetivo del negocio</h3>
            </div>
            {
              Array.isArray(objectiveBusiness) ? (
                <ul>
                  {objectiveBusiness.map(item => (
                    <li class="list-disc list-outside ml-5 text-base md:text-lg">
                      {item}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-balance text-base md:text-lg">
                  {objectiveBusiness}
                </p>
              )
            }
          </div>
          <div class="flex flex-col gap-4">
            <div class="flex flex-row gap-4 items-center">
              <Estrella class="h-8 w-8" />
              <h3 class="subtituloProyecto">Objetivo del usuario</h3>
            </div>
            {
              Array.isArray(objectiveUser) ? (
                <ul>
                  {objectiveUser.map(item => (
                    <li class="list-disc list-outside ml-5 text-base md:text-lg">
                      {item}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-balance text-base md:text-lg">{objectiveUser}</p>
              )
            }
          </div>
        </div>
      </section>

      {
        projectImagesList && (
          <div class="flex flex-col gap-0 w-full mx-auto bg-black-secondary/90">
            {projectImagesList?.map(img => (
              <Image
                src={img.src}
                alt={img.alt}
                class="shadow-xl"
              />
            ))}
          </div>
        )
      }

      {research && <Investigacion research={research} />}
      {
        problemDefinition && (
          <DefinicionProblema problemDefinition={problemDefinition} />
        )
      }
      {ideation && <Ideacion ideation={ideation} />}
      {
        testing && (
          <div class="flex flex-col gap-12">
            <h2 class="titleProyecto">Pruebas</h2>
            <p>{testing.summary}</p>
          </div>
        )
      }
    </div>
    {visualDesign && <Diseño visualDesign={visualDesign} />}
    
  </main>
  <Footer />
</Layout>

<script>
  const button = document.getElementById('backToTop')

  button?.addEventListener('click', () => {
    window.scrollTo({
      top: 0,
      behavior: 'smooth',
    })
  })
</script>
