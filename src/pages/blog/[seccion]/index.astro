---
import BarNav from '@/components/BarNav.astro'
import Footer from '@/components/Footer.astro'
import Layout from '@/layouts/Layout.astro'
import TarjetaArticulo from '@/components/blog/TarjetaArticulo.astro'
import Ondulada from '@/components/ui/Ondulada.astro'
import Panel from '@/components/ui/Panel.astro'
import Ventana from '@/components/ui/Ventana.astro'
import Etiqueta from '@/components/ui/Etiqueta.astro'
import Pestanas from '@/components/ui/Pestanas.astro'
import PanelPestana from '@/components/ui/PanelPestana.astro'
import Cierre from '@/components/ui/Cierre.astro'
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'
import { dataSeccionesBlog } from '@/data/blog/dataSeccionesBlog'
import { agruparPorCurso, postsDeSeccion } from '@/utils/blog'

export async function getStaticPaths() {
  const posts = await getCollection('blog')

  return dataSeccionesBlog.map(seccion => ({
    params: { seccion: seccion.slug },
    props: {
      seccion,
      grupos: agruparPorCurso(postsDeSeccion(posts, seccion.slug)),
    },
  }))
}

const { seccion, grupos } = Astro.props
const { title, description, image } = seccion
const nombre = title.replace('Apuntes sobre ', '')
const totalApuntes = grupos.reduce((total, grupo) => total + grupo.posts.length, 0)
---

<Layout title={`${title} - Gabriela Ferrer`}>
  <BarNav active={false} />
  <main
    class="mx-auto flex w-full max-w-[1200px] flex-col gap-14 md:gap-20 px-4 sm:px-8 pt-[calc(var(--altura-header)+2.5rem)] pb-20 font-rethink"
  >
    <!-- Portada del tema -->
    <Panel color="morado" as="header" class="overflow-visible">
      <Ondulada class="absolute -right-1 md:-right-8 -top-10 w-24 md:w-32 rotate-12" color="var(--color-secondary)" />
      <a
        href="/blog"
        class="inline-flex items-center gap-2 rounded-full border-2 border-black bg-white px-4 py-1.5 text-sm font-semibold text-black transition-colors duration-150 hover:bg-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
      >
        <Icon name="fa6-solid:arrow-left" width={14} height={14} aria-hidden="true" />
        Todos los temas
      </a>

      <p class="mt-8 text-center"><Etiqueta color="negro" mayusculas>Apuntes sobre</Etiqueta></p>
      <h1
        class="mt-4 text-center font-fantabular font-black text-white-cream leading-[0.85] tracking-tight text-balance text-[clamp(2.8rem,9vw,7rem)]"
      >
        {nombre}
      </h1>

      <Ventana class="mt-8 md:mt-12">
        <div class="grid items-center gap-8 md:grid-cols-2">
          <img
            src={image}
            alt=""
            class="sombra aspect-[4/3] w-full rounded-[1.25rem] object-cover object-center"
          />
          <div class="relative">
            <Ondulada class="w-12 mb-4" color="var(--color-pink)" />
            <p class="text-lg md:text-xl leading-relaxed text-pretty">{description}</p>
          </div>
        </div>
      </Ventana>

      <dl class="mt-6 grid gap-2 text-sm font-semibold text-white-cream sm:grid-cols-3">
        <div class="flex gap-1">
          <dt>Apuntes:</dt>
          <dd>{totalApuntes}</dd>
        </div>
        <div class="flex gap-1 sm:justify-center">
          <dt>Cursos:</dt>
          <dd>{grupos.length}</dd>
        </div>
        <div class="flex gap-1 sm:justify-end">
          <dt>por</dt>
          <dd>Gabriela Ferrer</dd>
        </div>
      </dl>
    </Panel>

    <!-- Apuntes agrupados por curso, en pestañas tipo carpeta -->
    {
      grupos.length === 0 ? (
        <Panel color="crema" class="border-dashed text-center">
          <p class="text-lg">
            Todavía no hay apuntes en este tema.{' '}
            <a href="/blog" class="font-semibold underline">
              Ver otros temas
            </a>
          </p>
        </Panel>
      ) : (
        <section aria-label="Apuntes por curso">
          <Pestanas
            pestanas={grupos.map(grupo => ({ id: grupo.ancla, texto: grupo.curso }))}
            etiqueta="Cursos del tema"
            color="rosa"
          >
            {grupos.map(grupo => (
              <PanelPestana id={grupo.ancla}>
                <Ventana>
                  <div class="mb-8 flex flex-col items-center gap-3 text-center">
                    <h2 class="font-fantabular text-3xl md:text-4xl font-bold text-balance">{grupo.curso}</h2>
                    <Etiqueta color="amarillo">
                      {`${grupo.posts.length} ${grupo.posts.length === 1 ? 'apunte' : 'apuntes'}`}
                    </Etiqueta>
                  </div>
                  <ol class="grid grid-cols-1 gap-5 md:grid-cols-2">
                    {grupo.posts.map((post, index) => (
                      <li>
                        <TarjetaArticulo post={post} numero={index + 1} />
                      </li>
                    ))}
                  </ol>
                </Ventana>
              </PanelPestana>
            ))}
          </Pestanas>
        </section>
      )
    }

    <Cierre
    titulo={'¡Sigamos\naprendiendo!'}
    texto="Si algún apunte te sirvió o quieres trabajar conmigo, escríbeme."
      enlaces={[
        { texto: 'Todos los temas', href: '/blog' },
        { texto: 'Escríbeme', href: '/contactame' },
      ]}
    />
  </main>
  <Footer />
</Layout>
