---
import BarNav from '@/components/BarNav.astro'
import Footer from '@/components/Footer.astro'
import Layout from '@/layouts/Layout.astro'
import TarjetaTema from '@/components/blog/TarjetaTema.astro'
import TarjetaArticulo from '@/components/blog/TarjetaArticulo.astro'
import Ondulada from '@/components/ui/Ondulada.astro'
import Subtitulo from '@/components/Subtitulo.astro'
import Button from '@/components/Button.astro'
import Ventana from '@/components/ui/Ventana.astro'
import Etiqueta from '@/components/ui/Etiqueta.astro'
import Pestanas from '@/components/ui/Pestanas.astro'
import PanelPestana from '@/components/ui/PanelPestana.astro'
import Cierre from '@/components/ui/Cierre.astro'
import Estrella from '@/assets/estrella.svg'
import { categoriasBlog, dataSeccionesBlog } from '@/data/blog/dataSeccionesBlog'
import { formatearFecha, getPostsRecientes, postsDeSeccion, seccionDe } from '@/utils/blog'

const CANTIDAD_RECIENTES = 4

const todosLosPosts = await getPostsRecientes()
const recientes = todosLosPosts.slice(0, CANTIDAD_RECIENTES)
const ultimaFecha = todosLosPosts[0]?.data.pubDate

const contarApuntes = (slug: string) => postsDeSeccion(todosLosPosts, slug).length

const nombreTema = (slug: string) =>
  dataSeccionesBlog.find(seccion => seccion.slug === slug)?.title.replace('Apuntes sobre ', '')

// Solo se muestran las categorías que tienen al menos un tema
const temasPorCategoria = categoriasBlog
  .map(categoria => ({
    ...categoria,
    secciones: dataSeccionesBlog.filter(s => s.categoria === categoria.id),
  }))
  .filter(categoria => categoria.secciones.length > 0)

const pestanas = temasPorCategoria.map(categoria => ({ id: categoria.id, texto: categoria.nombre }))

// Mismo carril que la página principal: todos los bloques de la caja
// comparten los márgenes laterales
const carril = 'w-full lg:w-11/12 max-w-sitio mx-auto px-4 sm:px-12 lg:px-0'
---

<Layout title="Blog de apuntes - Gabriela Ferrer">
  <BarNav active={false} />
  <!-- Misma estructura que la página principal: portada sobre fondo oscuro de
       puntos, una caja clara con barras Subtitulo y el cierre fuera de la caja -->
  <main
    class="flex flex-col items-center font-rethink select-none w-full bg-[url(/fondoDos.svg)] bg-[length:30px]"
  >
    <!-- Portada: igual que la de inicio (imagen + texto claro + botones) -->
    <section
      class="mx-auto w-full lg:w-4/5 max-w-sitio grid grid-cols-1 lg:grid-cols-2 items-center gap-10 px-4 md:px-12 lg:px-8 xl:px-0 pt-[calc(var(--altura-header)+3rem)] pb-20"
    >
      <div class="relative mx-auto w-full max-w-[520px]">
        <Ondulada class="absolute -left-2 top-4 w-16 md:w-20 -rotate-12" color="var(--color-secondary)" />
        <img
          src="/images/blog/portada-blog.webp"
          alt="Ilustración de Gabriela trabajando en su computador"
          class="mx-auto w-4/5 h-auto"
        />
      </div>

      <div class="flex flex-col gap-6 text-center lg:text-left">
        <div
          class="efecto-hundir font-fantabular font-light border-2 italic border-black w-fit bg-tag py-2 px-6 text-base md:text-lg mx-auto lg:mx-0 forma-hoja"
        >
          Blog de estudios
        </div>
        <h1 class="font-extrabold font-fantabular text-4xl text-pink">
          <span class="text-white">Mis</span> apuntes<span class="text-secondary">.</span>
        </h1>
        <p class="text-base font-normal leading-tight text-white">
          Lo que aprendo en cursos y lecturas, pasado del cuaderno a un lugar donde
          puedo encontrarlo cuando lo necesito.
        </p>

        <!-- Datos del blog en etiquetas -->
        <dl class="flex flex-wrap justify-center lg:justify-start gap-2">
          <div><dt class="sr-only">Temas</dt><dd><Etiqueta color="blanco">{dataSeccionesBlog.length} temas</Etiqueta></dd></div>
          <div><dt class="sr-only">Apuntes</dt><dd><Etiqueta color="blanco">{todosLosPosts.length} apuntes</Etiqueta></dd></div>
          <div>
            <dt class="sr-only">Última entrada</dt>
            <dd><Etiqueta color="amarillo">Última entrada: {ultimaFecha ? formatearFecha(ultimaFecha) : 'pronto'}</Etiqueta></dd>
          </div>
        </dl>

        <div class="flex flex-row flex-wrap justify-center lg:justify-start gap-4">
          <Button text="Ver temas" href="#temas" />
          {recientes.length > 0 && <Button text="Lo más reciente" href="#entradas-recientes" />}
        </div>
      </div>
    </section>

    <!-- Caja clara con el contenido, como "experiencia-container" en el inicio -->
    <section
      class="w-11/12 max-w-sitio flex flex-col gap-20 items-center bg-[url(/fondo.svg)] bg-[length:30px] rounded-ventana border-2 border-black overflow-hidden py-20 text-black"
    >
      <Subtitulo align="center" type="Sobre el blog" />
      <div class={carril}>
        <Ventana>
          <div class="flex flex-col gap-4 text-lg md:text-2xl font-semibold leading-snug text-pretty">
            <p>
              Este blog es mi cuaderno digital: aquí paso en limpio lo que aprendo en cursos y lecturas, explicado con
              mis propias palabras.
            </p>
            <p>
              Cada apunte está organizado por temas y cursos, del diseño gráfico a la programación, para encontrarlo
              cuando lo necesito.
            </p>
          </div>
        </Ventana>
      </div>

      {
        recientes.length > 0 && (
          <>
            <Subtitulo align="center" type="Lo último" />
            <div id="entradas-recientes" class:list={[carril, 'scroll-mt-28 flex flex-col gap-8']}>
              <h2 id="recientes" class="titulo-bloque efecto-resaltador w-fit">Entradas recientes</h2>
              <ul class="grid grid-cols-1 gap-5 md:grid-cols-2">
                {recientes.map(post => (
                  <li>
                    <TarjetaArticulo post={post} tema={nombreTema(seccionDe(post))} />
                  </li>
                ))}
              </ul>
            </div>
          </>
        )
      }

      {
        pestanas.length > 0 && (
          <>
            <Subtitulo align="center" type="Temas" />
            <div id="temas" class:list={[carril, 'scroll-mt-28 flex flex-col gap-8']}>
              <h2 id="titulo-temas" class="titulo-bloque efecto-resaltador w-fit">Temas por categoría</h2>
              <Pestanas pestanas={pestanas} etiqueta="Temas por categoría" color="amarillo">
                {temasPorCategoria.map(categoria => (
                  <PanelPestana id={categoria.id}>
                    <Ventana>
                      <h3 class="mb-8 text-center subtitulo">{categoria.nombre}</h3>
                      <ul class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">
                        {categoria.secciones.map(seccion => (
                          <li>
                            <TarjetaTema
                              seccion={seccion}
                              categoria={categoria.nombre}
                              totalApuntes={contarApuntes(seccion.slug)}
                            />
                          </li>
                        ))}
                      </ul>
                    </Ventana>
                  </PanelPestana>
                ))}
              </Pestanas>
            </div>
          </>
        )
      }
    </section>

    <!-- Cierre fuera de la caja, con su mismo ancho (como la Invitación del inicio) -->
    <div class="w-11/12 max-w-sitio py-16 md:py-24">
      <Cierre
        titulo={'¡Sigamos\naprendiendo!'}
        texto="Si algún apunte te sirvió o quieres trabajar conmigo, escríbeme."
        enlaces={[
          { texto: 'Escríbeme', href: '/contactame' },
          { texto: 'Ver mis proyectos', href: '/#proyectos-container' },
        ]}
      />
    </div>
  </main>
  <Footer />
</Layout>
