---
import BarNav from '@/components/BarNav.astro'
import Footer from '@/components/Footer.astro'
import Layout from '@/layouts/Layout.astro'
import DivisorTitulo from '@/components/blog/DivisorTitulo.astro'
import TarjetaTema from '@/components/blog/TarjetaTema.astro'
import TarjetaArticulo from '@/components/blog/TarjetaArticulo.astro'
import { Icon } from 'astro-icon/components'
import { categoriasBlog, dataSeccionesBlog } from '@/data/blog/dataSeccionesBlog'
import { getPostsRecientes, postsDeSeccion, seccionDe } from '@/utils/blog'

const CANTIDAD_RECIENTES = 4

const todosLosPosts = await getPostsRecientes()
const recientes = todosLosPosts.slice(0, CANTIDAD_RECIENTES)

const contarApuntes = (slug: string) =>
  postsDeSeccion(todosLosPosts, slug).length

const nombreTema = (slug: string) =>
  dataSeccionesBlog
    .find(seccion => seccion.slug === slug)
    ?.title.replace('Apuntes sobre ', '')

// Solo se muestran las categorías que tienen al menos un tema
const temasPorCategoria = categoriasBlog
  .map(categoria => ({
    ...categoria,
    secciones: dataSeccionesBlog.filter(s => s.categoria === categoria.id),
  }))
  .filter(categoria => categoria.secciones.length > 0)
---

<Layout title="Blog de apuntes - Gabriela Ferrer">
  <BarNav active={false} />
  <main class="flex flex-col items-center w-full font-rethink">
    <!-- Portada: yo y mis apuntes -->
    <section
      class="bg-[url(/fondoDos.svg)] bg-[length:30px] w-full px-4 sm:px-12 xl:px-0 pt-28 min-h-screen"
    >
    <div class="max-w-[1280px] mx-auto w-full grid items-center gap-10 lg:grid-cols-2 justify-items-center">
      <div class="flex flex-col gap-6 text-center lg:text-left">
        <h1 class="text-5xl leading-tight font-fantabular sm:text-7xl text-white">
          <span
            class="relative font-bold font-rethink after:bg-primary after:-z-10 after:w-full after:absolute after:left-0 after:bottom-1 after:h-[50%] z-20"
            >Mi blog personal</span
          ><br />
          <span class="italic font-normal">de estudios</span>
        </h1>
        <p class="text-lg text-pretty max-w-prose mx-auto lg:mx-0 text-white">
          Lo que aprendo en cursos y lecturas, pasado del cuaderno a un lugar
          donde puedo encontrarlo cuando lo necesito.
        </p>
      </div>
      <img
        src="/images/blog/portada-blog.webp"
        alt="Gabriela revisando sus apuntes"
        class="h-full max-h-3/4"
      />
    </div>
    </section>

    <div class="w-full flex flex-col gap-20 py-20">
      <!-- Entradas recientes -->
      {
        recientes.length > 0 && (
          <section class="flex flex-col gap-8" aria-labelledby="recientes">
            <DivisorTitulo titulo="Entradas recientes" id="recientes" class="-mt-20" />
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 mx-auto w-full max-w-[1280px] px-4 sm:px-12 xl:px-0">
              {recientes.map(post => (
                <li>
                  <TarjetaArticulo
                    post={post}
                    tema={nombreTema(seccionDe(post))}
                  />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- Temas agrupados por categoría -->
      <section class="flex flex-col gap-12" aria-labelledby="temas">
        <DivisorTitulo titulo="Temas" id="temas" />
        {
          temasPorCategoria.map(categoria => (
            <div class="mx-auto w-full max-w-[1280px] px-4 sm:px-12 xl:px-0 flex flex-col gap-6">
              <h3 class="flex items-center gap-3 text-2xl font-fantabular">
                <Icon name="fa6-solid:folder" width={24} height={24} aria-hidden="true" />
                {categoria.nombre}
              </h3>
              <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {categoria.secciones.map(seccion => (
                  <li>
                    <TarjetaTema
                      seccion={seccion}
                      totalApuntes={contarApuntes(seccion.slug)}
                    />
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>
    </div>
  </main>
  <Footer />
</Layout>
