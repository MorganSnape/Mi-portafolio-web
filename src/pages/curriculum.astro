---
import Layout from '../layouts/Layout.astro'
import { Icon } from 'astro-icon/components'
import Etiqueta from '@/components/ui/Etiqueta.astro'
import Button from '@/components/Button.astro'

const cv = {
  name: 'Gabriela Ferrer',
  role: 'Diseñadora Gráfica',
  subtitle: 'Identidad de marca y UX/UI',
  availability: 'Disponible para etapa productiva SENA',
  summary:
    'Diseñadora gráfica en formación en el SENA, enfocada en identidad de marca y diseño UX/UI. Creo marcas completas, desde el logotipo y la paleta hasta piezas para redes e interfaces digitales, y antes de diseñar investigo con usuarios para que cada decisión tenga un porqué. Mis conocimientos de desarrollo front-end me permiten entregar diseños claros y fáciles de implementar.',
  // TODO: agrega tu ciudad, por ejemplo "Pereira, Colombia"
  location: 'Colombia',
  email: 'gabriellangelesferrer@gmail.com',
  phone: '+57 321 326 6303',
  links: [
    {
      label: 'gabrielaferrer.vercel.app',
      href: 'https://gabrielaferrer.vercel.app',
      icon: 'fa6-solid:globe',
    },
  ],
}

const experiences = [
  {
    position: 'Diseñadora UX/UI',
    company: 'KunturWing',
    date: 'Nov 2024 – Oct 2025',
    items: [
      'Creé la identidad visual de la marca: logotipo, paleta de color, tipografía y lineamientos de uso.',
      'Diseñé y mantuve el sistema de diseño, asegurando coherencia visual.',
      'Definí flujos de navegación, wireframes y prototipos de alta fidelidad junto al equipo de desarrollo.',
      'Apoyé la implementación front-end con React, TypeScript y Tailwind CSS.',
      // TODO: agrega aquí un resultado concreto (pantallas diseñadas, lanzamiento del producto, etc.)
    ],
  },
  {
    position: 'Asesora de servicio al cliente',
    company: 'Atento Colombia',
    date: 'Oct 2020 – May 2023',
    items: [
      'Atendí clientes en ventas, retención, fidelización y soporte técnico para una empresa de telecomunicaciones de Chile.',
      'Desarrollé escucha activa y empatía, habilidades que hoy aplico al investigar con usuarios.',
      'Trabajé con metas de calidad y tiempos de respuesta en un entorno de alta exigencia.',
    ],
  },
  {
    position: 'Administradora',
    company: "Duke's Delicioso",
    date: 'Nov 2019 – Jul 2020',
    items: [
      'Optimicé el control de inventarios con Excel y mejoré el procedimiento de cierre de caja.',
    ],
  },
]

const education = [
  {
    title: 'Tecnología en Diseño Gráfico',
    institution: 'SENA',
    date: 'En curso',
  },
  {
    title: 'Certificado Profesional de Diseño UX',
    institution: 'Google + Coursera',
    date: 'En curso',
  },
  {
    title: 'Curso de UX Research y UX Writing (36 h)',
    institution: 'Universidad Católica de Pereira',
    date: '2024',
  },
  {
    title: 'Programación JavaScript Front-End',
    institution: 'Oracle + Alura Latam',
    date: '2025',
  },
  {
    title: 'Diplomado Programador Full Stack Junior (176 h)',
    institution: 'Universidad Tecnológica de Pereira',
    date: '2023 – 2024',
  },
]

const skills = [
  {
    label: 'Diseño gráfico',
    text: 'identidad visual, manuales de marca, tipografía, teoría del color, piezas para redes e impresos.',
  },
  {
    label: 'UX/UI',
    text: 'investigación de usuarios, análisis competitivo, user personas, arquitectura de información, wireframes, prototipos, pruebas de usabilidad, sistemas de diseño y Design Thinking.',
  },
  {
    label: 'Conocimientos técnicos',
    text: 'HTML, CSS, JavaScript, React y Tailwind CSS, para una entrega clara al equipo de desarrollo.',
  },
  {
    label: 'Personales',
    text: 'comunicación, resolución de problemas, trabajo en equipo y adaptación al cambio.',
  },
]

const software = [
  'Illustrator',
  'Photoshop',
  'InDesign',
  'Premiere',
  'Figma',
  'FigJam',
  'Miro',
  'Canva',
  'Notion',
  'Midjourney',
  'Adobe Firefly',
]

// TODO: agrega tu nivel de inglés, por ejemplo "Inglés B1". Si no puedes demostrarlo, déjalo así.
const languages = ['Español nativo']
---

<Layout title="Currículum - Gabriela Ferrer">
  <main class="tipografia-fija bg-primary/20 text-sm font-normal print:bg-white">
    <!-- Estilo sobrio: todo en negro y grises, títulos en mayúsculas espaciadas,
         una línea corta antes de cada sección y una barra de contacto entre dos líneas. -->
    <article
      class="cv max-w-4xl mx-auto px-6 sm:px-14 py-14 bg-white flex flex-col gap-8 print:gap-4 text-black leading-relaxed print:leading-snug"
    >
      <!-- Encabezado -->
      <header class="flex flex-col gap-6 print:gap-4">
        <div class="flex flex-col gap-3">
          <h1 class="font-fantabular font-bold text-5xl leading-none tracking-wide">
            {cv.name}
          </h1>
          <p class="text-xs font-bold uppercase tracking-[0.2em]">
            {cv.role} · {cv.subtitle}
          </p>
          <p class="text-xs text-gray-500">{cv.availability}</p>
        </div>

        <!-- Contacto: entre dos líneas, como en el ejemplo -->
        <div
          class="-mx-6 px-6 sm:-mx-14 sm:px-14 py-2.5 border-y border-black flex flex-wrap justify-between gap-x-6 gap-y-1 text-xs"
        >
          <a href={`mailto:${cv.email}`} class="hover:underline underline-offset-2">{cv.email}</a>
          <a href={`tel:${cv.phone.replace(/\s/g, '')}`} class="hover:underline underline-offset-2">{cv.phone}</a>
          <span>{cv.location}</span>
          {
            cv.links.map(link => (
              <a href={link.href} class="hover:underline underline-offset-2">{link.label}</a>
            ))
          }
        </div>
      </header>

      <!-- Perfil -->
      <section class="flex flex-col gap-3">
        <h2 class="text-base font-bold uppercase tracking-[0.15em]">Perfil</h2>
        <p class="text-black-secondary text-pretty">{cv.summary}</p>
      </section>

      <!-- Experiencia -->
      <section class="flex flex-col gap-5 print:gap-2.5">
        <h2 class="text-base font-bold uppercase tracking-[0.15em]">Experiencia</h2>
        {
          experiences.map(exp => (
            <div class="flex flex-col gap-1.5 print:break-inside-avoid">
              <Etiqueta class="w-fit">{exp.date}</Etiqueta>
              <h3>
                <strong>{exp.position}</strong>, <em>{exp.company}</em>
              </h3>
              <ul class="ml-5 space-y-0.5 list-disc marker:text-gray-400 text-black-secondary">
                {exp.items.map(item => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <!-- Educación -->
      <section class="flex flex-col gap-5 print:gap-2.5 print:break-inside-avoid">
        <span class="w-24 border-t border-black" aria-hidden="true"></span>
        <h2 class="text-base font-bold uppercase tracking-[0.15em]">Educación</h2>
        <ul class="grid sm:grid-cols-2 print:grid-cols-3 gap-x-8 gap-y-4 print:gap-y-2.5">
          {
            education.map(edu => (
              <li class="flex flex-col gap-1.5">
                <Etiqueta class="w-fit">{edu.date}</Etiqueta>
                <span>
                  <strong>{edu.title}</strong>, {edu.institution}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Habilidades y métodos -->
      <section class="flex flex-col gap-5 print:gap-2.5 print:break-inside-avoid">
        <span class="w-24 border-t border-black" aria-hidden="true"></span>
        <h2 class="text-base font-bold uppercase tracking-[0.15em]">Habilidades y métodos</h2>
        <ul class="space-y-1 text-black-secondary">
          {
            skills.map(skill => (
              <li>
                <strong class="text-black">{skill.label}:</strong> {skill.text}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Software e idiomas: lado a lado para que todo quepa en una hoja -->
      <div class="grid sm:grid-cols-[3fr_1fr] print:grid-cols-[3fr_1fr] gap-8 print:gap-6">
      <section class="flex flex-col gap-5 print:gap-2.5 print:break-inside-avoid">
        <span class="w-24 border-t border-black" aria-hidden="true"></span>
        <h2 class="text-base font-bold uppercase tracking-[0.15em]">Software</h2>
        <ul class="grid grid-cols-2 sm:grid-cols-3 print:grid-cols-4 gap-x-6 gap-y-0.5 text-xs">
          {software.map(tool => <li>{tool}</li>)}
        </ul>
      </section>

      <section class="flex flex-col gap-5 print:gap-2.5 print:break-inside-avoid">
        <span class="w-24 border-t border-black" aria-hidden="true"></span>
        <h2 class="text-base font-bold uppercase tracking-[0.15em]">Idiomas</h2>
        <p class="text-xs">{languages.join('  ·  ')}</p>
      </section>
      </div>
    </article>

    <!-- Botón de descarga: el PDF está en public/pdf (se genera desde esta misma página) -->
    <div class="print:hidden fixed bottom-8 right-8 z-50">
      <Button
        text="Descargar hoja de vida"
        href="/pdf/Hoja_de_vida_Gabriela_Ferrer.pdf"
        download="Hoja_de_vida_Gabriela_Ferrer.pdf"
        tono="claro"
        typeIcon
      >
        <Icon name="fa6-solid:file-arrow-down" class="size-4" aria-hidden="true" />
      </Button>
    </div>
  </main>
</Layout>

<style is:global>
  /* @page va FUERA del @media print y con margen 0:
     así el navegador no tiene espacio para imprimir la fecha, la URL y el número de página. */
  @page {
    size: letter;
    margin: 0;
  }

  @media print {
    /* Las clases de Tailwind usan rem, así que se reduce la base
       para que todo el currículum quepa en una sola hoja. */
    html {
      font-size: 13px !important;
    }

    body {
      margin: 0 !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    main {
      background: white !important;
    }

    .cv {
      max-width: none !important;
      margin: 0 !important;
      padding: 0.45in 0.6in !important;
    }

    /* La barra de contacto sale de borde a borde de la hoja */
    .cv header > div:last-child {
      margin-inline: -0.6in !important;
      padding-inline: 0.6in !important;
    }

    /* Oculta el menú y el pie de página del Layout al imprimir */
    header:not(.cv header),
    footer,
    nav {
      display: none !important;
    }
  }
</style>
