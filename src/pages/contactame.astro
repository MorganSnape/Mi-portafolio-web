---
import BarNav from '@/components/BarNav.astro'
import Footer from '@/components/Footer.astro'
import Layout from '@/layouts/Layout.astro'

import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Etiqueta from '@/components/ui/Etiqueta.astro'
import Ondulada from '@/components/ui/Ondulada.astro'

// Cambia esta ruta por la de la ilustración del PC que ya usas en Contactame.astro.
// Si la tienes como SVG inline o como componente, pega ese bloque dentro del <figure> y borra este import.
import ilustracionPc from '@/assets/Ilustraciones/Computador.svg'

const telefono = '573213266303'
const mensajeWhatsApp =
  'Hola Gabriela, vi tu portafolio y me gustaría hablar contigo.'

const directos = [
  {
    etiqueta: 'Correo',
    valor: 'gabriellangelesferrer@gmail.com',
    href: 'mailto:gabriellangelesferrer@gmail.com',
    colorEtiqueta: 'bg-tag',
    externo: false,
  },
  {
    etiqueta: 'WhatsApp',
    valor: '+57 321 326 6303',
    href: `https://wa.me/${telefono}?text=${encodeURIComponent(mensajeWhatsApp)}`,
    colorEtiqueta: 'bg-asparagus-300',
    externo: true,
  },
]

const redes = [
  {
    nombre: 'LinkedIn',
    icono: 'fa6-brands:linkedin-in',
    href: 'https://www.linkedin.com/in/gabrielaferrer-diseno-ux',
  },
  {
    nombre: 'Behance',
    icono: 'fa6-brands:behance',
    href: 'https://www.behance.net/gabriellangeles',
  },
]

// ── Botones de contacto en pares ──
// Cada enlace es un botón independiente que se hunde solo, pero el par se ve
// como una sola tarjeta: van pegados, comparten el borde del medio (-mt-0.5),
// solo el primero redondea arriba y solo el último abajo.
//
// El hundido está escrito aquí (no con efecto-hundir) para controlar tres
// cosas que lo hacían ver poco natural:
//  1. El hover lo detecta el <li> (group/boton), que NO se mueve. Antes lo
//     detectaba el propio botón: al hundirse se corría debajo del cursor, perdía
//     el hover, volvía a subir… y temblaba en los bordes.
//  2. Ritmo de botón físico: se hunde rápido (100 ms) y sube más despacio
//     (200 ms), con una curva que frena al final. El color de fondo y la flecha
//     se animan con el mismo ritmo (antes el color cambiaba de golpe).
//  3. El botón de abajo queda por encima (z-10), así la sombra del de arriba
//     nunca se asoma sobre él mientras se anima.
// Ojo: las clases van escritas completas (sin armarlas con ${}) para que
// Tailwind las encuentre al leer el archivo.
const curva = 'ease-[cubic-bezier(0.2,0.8,0.2,1)]'
const fila = [
  'flex items-center gap-4 px-5 py-5 sm:px-7 border-2 border-black bg-white',
  // Sombra dura de la marca en reposo (la misma medida que efecto-hundir)
  '[box-shadow:var(--hundir)_var(--hundir)_0_var(--color-black)]',
  // Animación: baja en 100 ms, sube en 200 ms
  `transition-[translate,box-shadow,background-color] duration-200 ${curva}`,
  'group-hover/boton:duration-100 active:duration-75 motion-reduce:transition-none',
  // Estado hundido: pierde la sombra y se tiñe (con mouse, Tab o al tocar)
  'group-hover/boton:[box-shadow:0_0_0_var(--color-black)] focus-visible:[box-shadow:0_0_0_var(--color-black)] active:[box-shadow:0_0_0_var(--color-black)]',
  'group-hover/boton:bg-kournikova-50 focus-visible:bg-kournikova-50',
  'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary',
].join(' ')
const flecha = `size-4 shrink-0 rotate-45`

// Hacia dónde se hunde cada botón:
// el último en diagonal (su sombra se ve abajo y a la derecha);
// los que tienen otro debajo solo a la derecha, para no montarse sobre él.
const diagonal =
  'group-hover/boton:[translate:var(--hundir)_var(--hundir)] focus-visible:[translate:var(--hundir)_var(--hundir)] active:[translate:var(--hundir)_var(--hundir)]'
const derecha =
  'group-hover/boton:[translate:var(--hundir)_0] focus-visible:[translate:var(--hundir)_0] active:[translate:var(--hundir)_0]'
const posicion = (i: number, total: number) => [
  i === 0 && 'rounded-t-tarjeta',
  i === total - 1 ? ['rounded-b-tarjeta', diagonal] : derecha,
]
// Los botones de un par van pegados (sin gap)
const par = 'flex flex-col'
// <li>: detecta el hover. Del segundo en adelante sube 2px para compartir el
// borde y queda por encima del anterior.
const contenedor = (i: number) => [
  'group/boton',
  i > 0 && '-mt-0.5 relative z-10',
]
---

<Layout title="Trabajemos juntos - Contáctame">
  <BarNav />
  <main
    class="flex flex-col items-center gap-8 font-rethink select-none w-full"
  >
    <section
      aria-labelledby="titulo-contacto"
      class="mx-auto grid w-full lg:w-11/12 max-w-sitio gap-12 px-6 lg:px-0 pt-[calc(var(--altura-header)+3rem)] pb-20 lg:pb-28 lg:grid-cols-2 lg:grid-rows-[auto_auto] lg:gap-x-16 lg:gap-y-10 text-black"
    >
      <!-- Alineación:
           · mismo ancho que la barra de navegación (lg:w-11/12 max-w-sitio, lg:px-0),
             así el título arranca en línea con el logo y los botones terminan en línea con el menú.
           · Sin min-h: las filas miden lo que su contenido, y el título y la
             ilustración quedan juntos en la columna izquierda.
           · Los botones ocupan las dos filas a la derecha y se centran en vertical
             respecto a toda la columna izquierda. -->
      <!-- Título y texto: arriba a la izquierda -->
      <header class="flex flex-col gap-5 lg:col-start-1 lg:row-start-1 lg:self-end">
        <Etiqueta color="negro" mayusculas class="w-fit">Hablemos</Etiqueta>
        <h1
          id="titulo-contacto"
          class="titulo-seccion"
        >
          Contáctame
        </h1>
        <p class="max-w-[52ch] text-lg leading-relaxed text-black-secondary">
          ¿Tienes una marca por crear o un producto por diseñar? Escríbeme por
          el medio que prefieras y conversamos.
        </p>
      </header>

      <!-- Opciones de contacto: derecha. En móvil van antes de la ilustración -->
      <div
        class="flex flex-col gap-8 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center"
      >
        <ul class={par}>
          {
            directos.map((d, i) => (
              <li class:list={contenedor(i)}>
                <a
                  href={d.href}
                  class:list={[fila, posicion(i, directos.length)]}
                  {...(d.externo && {
                    target: '_blank',
                    rel: 'noopener noreferrer',
                  })}
                >
                  <span class="flex min-w-0 flex-1 flex-col items-start gap-2">
                    <span
                      class={`rounded-full border-2 border-black px-3 py-0.5 text-sm font-bold ${d.colorEtiqueta}`}
                    >
                      {d.etiqueta}
                    </span>
                    <span class="break-all text-lg font-medium sm:break-normal">
                      {d.valor}
                    </span>
                  </span>
                  <span
                    class="hidden sm:flex size-9 shrink-0 items-center justify-center rounded-full border-2 border-black bg-pink transition-colors duration-150 group-hover/boton:bg-secondary "
                    aria-hidden="true"
                  >
                    <Icon name="fa6-solid:arrow-up" class={flecha} />
                  </span>
                  {d.externo && (
                    <span class="sr-only">(se abre en una pestaña nueva)</span>
                  )}
                </a>
              </li>
            ))
          }
        </ul>

        <ul class={par}>
          {
            redes.map((r, i) => (
              <li class:list={contenedor(i)}>
                <a
                  href={r.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[fila, posicion(i, redes.length)]}
                >
                  <span class="grid size-11 shrink-0 place-items-center rounded-chico border-2 border-black bg-black text-white">
                    <Icon name={r.icono} class="size-6" aria-hidden="true" />
                  </span>
                  <span class="flex-1 text-lg font-bold">{r.nombre}</span>
                  <span class="sr-only">(se abre en una pestaña nueva)</span>
                  <span
                    class="hidden sm:flex size-9 shrink-0 items-center justify-center rounded-full border-2 border-black bg-pink transition-colors duration-150 group-hover/boton:bg-secondary "
                    aria-hidden="true"
                  >
                    <Icon name="fa6-solid:arrow-up" class={flecha} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Ilustración del PC: abajo a la izquierda -->
      <figure
        class="relative mx-auto w-full max-w-md lg:col-start-1 lg:row-start-2 lg:mx-0 lg:max-w-lg lg:self-start"
      >
        <Image
          src={ilustracionPc}
          alt="Ilustración de un PC con plantas"
          class="h-auto w-full"
          loading="eager"
        />
      </figure>
    </section>
  </main>
  <Footer />
</Layout>
