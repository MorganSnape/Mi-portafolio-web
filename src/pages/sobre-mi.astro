---
import Layout from '@/layouts/Layout.astro'
import SobreMi from '@/components/indexComponents/SobreMi.astro'
import Subtitulo from '@/components/Subtitulo.astro'
import { estudios } from '@/data/studies'
import CardEstudios from '@/components/CardEstudios.astro'
import Footer from '@/components/Footer.astro'
import BarNav from '@/components/BarNav.astro'
import Invitacion from '@/components/invitacion.astro'
---

<Layout title="Gabriela Ferrer - Bienvenido a mi portafolio.">
  <BarNav />
  <main
    class="flex flex-col items-center gap-8 font-rethink select-none w-full mt-10"
  >
    <SobreMi />
    <section id="estudios-container" class="w-full -mt-8">
      <Subtitulo align="center" type="Estudios" />
      <div
        class="grid grid-cols-1 md:grid-rows-2 md:grid-cols-2 gap-8 justify-center items-center py-20 mx-auto lg:w-4/5 max-w-[1280px] px-4 sm:px-12 xl:px-0"
      >
        {estudios.map(estudio => <CardEstudios {...estudio} />)}
      </div>
    </section>
    <Invitacion />
  </main>
  <Footer />
</Layout>
