---
import '@/styles/global.css'
import SideNav from '@/components/blog/SideNav.astro'
import Footer from '@/components/Footer.astro'
import Ventana from '@/components/blog/ui/Ventana.astro'

const { title, headings = [], volver = { href: '/blog', texto: 'Inicio de Blog' } } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Blog - {title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rethink+Sans:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://use.typekit.net/eft1vyl.css" />
  </head>
  <body class="text-gray-800 font-sans min-h-screen flex flex-col overflow-x-hidden">
    <div class="mx-auto flex w-full max-w-[1400px] gap-6 px-3 sm:px-6 py-6 font-rethink">
      <SideNav headings={headings} volver={volver} class="hidden lg:block" />
      <main class="flex min-w-0 flex-1 flex-col gap-10 md:gap-14">
        <slot name="encabezado" />
        <Ventana class="blog-contenido" cuerpo="px-5 md:px-12 py-10 md:py-12">
          <slot />
        </Ventana>
        <slot name="cierre" />
      </main>
    </div>
    <Footer />
  </body>
</html>

<style is:global>
  /* Encabezados */
.blog-contenido {
  h1 {
    font-family: var(--font-fantabular);
    font-size: 2rem;
    font-weight: 600;
    margin: 0rem 0 2rem 0;
  }

  h3 {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0rem 0 2rem 0;
    font-family: var(--font-fantabular);
  }
  h4 {
    font-size: 1rem;
    font-family: var(--font-fantabular);
    font-weight: 600;
    padding: 4px 20px;
    border-bottom: solid var(--color-pink) 3px;
    border-left: solid var(--color-pink) 3px;
    margin: 2rem 0rem;
  }
  h5 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0rem 0 2rem 0;
  }
  p {
    margin: 0rem 0 20px 0;
    font-size: 17px;
    font-weight: 400;
  }

  li {
    list-style: outside;
    font-size: 17px;
    font-weight: 400;
    margin: 0 0 0.35rem 0;
    padding-left: 0.25rem;
  }

  li p {
    margin: 0;
  }

  ul,
  ol {
    margin: 0rem 0 12px 0;
    padding-left: 1.25rem;
  }

  pre{
    padding: 1rem;
  }
  mark {
  background-color: var(--color-tickle-me-pink-200); /* Color de fondo suave */
  color: var(--color-tickle-me-pink-600);            /* Color del texto */
  padding: 0.1em 0.3em;      /* Espaciado interno */
  border-radius: 4px;        /* Bordes redondeados */
}

  .blog-content-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: center;
    width: 100%;
  }

  .blog-content-grid-responsive {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    width: 100%;
  }

  .blog-content-grid > div,
  .blog-content-grid-responsive > div {
    width: 100%;
  }

  .blog-content-note {
    background-color: var(--color-trendy-pink-200);
    padding: 1.25rem 1.25rem 0.125rem;
    border-radius: 0.5rem;
    color: var(--color-trendy-pink-900);
  }

  @media (min-width: 768px) {
    .blog-content-grid-responsive {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
}
</style>
