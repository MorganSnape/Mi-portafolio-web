---
import SocialMediaButtons from '@/components/SocialMediaButtons.astro'
import { navLinks } from '@/data/navLinks'

import Logo from 'public/negativo.svg'
---

<!-- Esquinas invertidas: el footer sube 2rem (-mt-8) y se mete debajo del final
     de la página. Esa franja de arriba es transparente, así que se sigue viendo
     el fondo de la página, y solo las dos esquinas se pintan con el fondo oscuro
     recortado en cuarto de círculo. Resultado: parece que la parte clara tiene
     las esquinas de abajo redondeadas y está puesta encima del footer.
     En páginas con fondo oscuro (inicio, sobre mí) se funde sin notarse. -->
<footer class="relative -mt-8 text-white w-full">
  <div aria-hidden="true" class="pointer-events-none flex h-8 justify-between">
    <span
      class="size-8 bg-[url(/fondoDos.svg)] bg-[length:30px] [mask-image:radial-gradient(circle_at_100%_0,transparent_2rem,#000_calc(2rem+1px))]"
    ></span>
    <span
      class="size-8 bg-[url(/fondoDos.svg)] bg-[length:30px] [mask-image:radial-gradient(circle_at_0_0,transparent_2rem,#000_calc(2rem+1px))]"
    ></span>
  </div>
  <div class="bg-[url(/fondoDos.svg)] bg-[length:30px]">
  <div
    class="flex flex-col gap-6 md:flex-row justify-center md:justify-between w-full lg:w-4/5 max-w-sitio px-4 md:px-12 mx-auto py-10"
  >
    <Logo class="h-20 md:h-28 w-auto fill-white pointer-events-none" />
    <div
      class="flex flex-col gap-4 max-w-64 items-center md:items-start mx-auto"
    >
      <p>Navegación</p>
      <ul class="grid grid-cols-2 gap-x-8">
        {
          navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="font-rethink h-full text-white text-sm font-normal
              hover:text-gray-400"
                arial-label={`Boton redirige a ${link.name}`}
              >
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="flex flex-col gap-4 items-center md:items-start">
      <p>Mis redes:</p>
      <SocialMediaButtons />
    </div>
  </div>
  <div class='w-full bg-black-secondary border-t-2'>
    <div
      class="min-h-10 w-full max-w-sitio px-4 md:px-12 flex flex-col gap-2 justify-center items-center mx-auto"
    >
      <p class="text-xs lg:text-sm text-center">
        Sitio construido por Gabriela Ferrer · Portafolio {
          new Date().getFullYear()
        }
      </p>
    </div>
  </div>
  </div>
</footer>
