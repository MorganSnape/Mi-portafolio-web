---
import SocialMediaButtons from '@/components/SocialMediaButtons.astro'
import { navLinks } from '@/data/navLinks'

import Logo from 'public/negativo.svg'
---

<footer class="bg-[url(/fondoDos.svg)] bg-[length:30px] text-white w-full">
  <div
    class="flex flex-col gap-6 md:flex-row justify-center md:justify-between w-full lg:w-4/5 max-w-[1280px] px-4 md:px-12 mx-auto py-10"
  >
    <Logo class="h-20 md:h-28 w-auto fill-white pointer-events-none" />
    <div
      class="flex flex-col gap-4 max-w-64 items-center md:items-start mx-auto"
    >
      <p>Navegación</p>
      <ul class="grid grid-cols-2 gap-x-8">
        {
          navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="font-rethink h-full text-white text-sm font-normal
              hover:text-gray-400"
                arial-label={`Boton redirige a ${link.name}`}
              >
                {link.name}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/blog"
            arial-label="Boton redirige a blog"
            class="font-rethink h-full text-white text-sm font-normal
              hover:text-gray-400"
          >
            Blog
          </a>
        </li>
      </ul>
    </div>
    <div class="flex flex-col gap-4 items-center md:items-start">
      <p>Mis redes:</p>
      <SocialMediaButtons />
    </div>
  </div>
  <div class='w-full bg-black-secondary border-t-2'>
    <div
      class="min-h-10 w-full max-w-[1280px] px-4 md:px-12 flex flex-col gap-2 justify-center items-center mx-auto"
    >
      <p class="text-xs text-center">
        Sitio construido por Gabriela Ferrer · Portafolio {
          new Date().getFullYear()
        }
      </p>
    </div>
  </div>
</footer>
