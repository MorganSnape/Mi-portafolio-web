---
import { Icon } from 'astro-icon/components'
import Etiqueta from '@/components/ui/Etiqueta.astro'
import { formatearFecha, urlPost, type Post } from '@/utils/blog'

interface Props {
  post: Post
  /** Posición dentro del curso. Si no se pasa, se muestra un ícono. */
  numero?: number
  /** Nombre del tema, útil en "Entradas recientes" donde se mezclan temas. */
  tema?: string
}

const { post, numero, tema } = Astro.props
---

<a
  href={urlPost(post)}
  class="group tag-me flex h-full items-center gap-4 rounded-2xl bg-white p-3 md:p-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black"
>
  <span
    class="flex size-11 shrink-0 items-center justify-center rounded-full border-2 border-black bg-secondary font-fantabular font-bold"
    aria-hidden="true"
  >
    {
      numero !== undefined ? (
        String(numero).padStart(2, '0')
      ) : (
        <Icon name="fa6-solid:file-lines" width={16} height={16} />
      )
    }
  </span>
  <span class="flex min-w-0 flex-1 flex-col gap-1.5">
    <span class="font-semibold leading-snug text-black line-clamp-3 sm:line-clamp-2">{post.data.title}</span>
    <span class="flex flex-wrap items-center gap-2 text-sm text-gray-500">
      {tema && <Etiqueta color="morado">{tema}</Etiqueta>}
      <time datetime={post.data.pubDate.toISOString()}>{formatearFecha(post.data.pubDate)}</time>
    </span>
  </span>
  <span
    class="hidden sm:flex size-9 shrink-0 items-center justify-center rounded-full border-2 border-black bg-pink transition-colors duration-150 group-hover:bg-secondary"
    aria-hidden="true"
  >
    <Icon name="fa6-solid:arrow-up" width={14} height={14} class="rotate-45" />
  </span>
</a>
