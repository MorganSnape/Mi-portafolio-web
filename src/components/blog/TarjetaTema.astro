---
import { Icon } from 'astro-icon/components'
import type { SectionBlogType } from '@/models'

interface Props {
  seccion: SectionBlogType
  totalApuntes: number
}

const { seccion, totalApuntes } = Astro.props
---

<a
  href={`/blog/${seccion.slug}`}
  class="block rounded-xl md:rounded-2xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black"
  aria-label={`Abrir ${seccion.title}`}
>
  <article
    class="group flex flex-col h-full min-h-[360px] border-2 border-black rounded-xl md:rounded-2xl bg-white overflow-hidden"
  >
    <div class="h-10 flex items-center gap-2 px-4 border-b-4 border-black shrink-0">
      <span class="h-3 w-3 bg-black rounded-full"></span>
      <span class="h-3 w-3 bg-black rounded-full"></span>
      <span class="h-3 w-3 bg-black rounded-full"></span>
    </div>
    <header class="relative w-full h-40 overflow-hidden rounded-b-2xl shadow-md shrink-0">
      <img
        src={seccion.image}
        alt=""
        loading="lazy"
        class="w-full h-full object-cover object-center transition-transform duration-300 group-hover:scale-110 motion-reduce:transition-none"
      />
    </header>
    <div class="flex flex-col flex-1 gap-2 p-4">
      <h3 class="text-base md:text-lg font-medium font-fantabular">
        {seccion.title}
      </h3>
      <p class="text-sm lg:text-base text-pretty line-clamp-3">
        {seccion.description}
      </p>
      <div class="mt-auto flex items-center justify-between pt-2">
        <span class="bg-secondary border border-black px-2 py-0.5 text-xs font-semibold">
          {totalApuntes} {totalApuntes === 1 ? 'apunte' : 'apuntes'}
        </span>
        <Icon
          name="fa6-solid:arrow-up"
          height={20}
          width={20}
          aria-hidden="true"
          class="rotate-45 transition-transform duration-200 group-hover:rotate-90 motion-reduce:transition-none"
        />
      </div>
    </div>
  </article>
</a>
