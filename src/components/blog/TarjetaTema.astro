---
import Etiqueta from '@/components/blog/ui/Etiqueta.astro'
import type { SectionBlogType } from '@/models'

interface Props {
  seccion: SectionBlogType
  totalApuntes: number
  /** Nombre de la categoría (Diseño, Programación...) */
  categoria?: string
}

const { seccion, totalApuntes, categoria } = Astro.props
const nombre = seccion.title.replace('Apuntes sobre ', '')
---

<a
  href={`/blog/${seccion.slug}`}
  class="group flex h-full flex-col gap-3 rounded-[1.5rem] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black"
>
  <div
    class="tag-me aspect-[4/3] overflow-hidden rounded-[1.25rem] bg-white"
  >
    <img
      src={seccion.image}
      alt=""
      loading="lazy"
      class="size-full object-cover object-center transition-transform duration-300 group-hover:scale-105 motion-reduce:transition-none"
    />
  </div>
  <h3 class="mt-2 text-center text-lg md:text-xl font-semibold">{nombre}</h3>
  <div class="flex flex-wrap justify-center gap-2">
    {categoria && <Etiqueta>{categoria}</Etiqueta>}
    <Etiqueta color="amarillo">{`${totalApuntes} ${totalApuntes === 1 ? 'apunte' : 'apuntes'}`}</Etiqueta>
  </div>
  <p class="px-2 text-center text-sm text-gray-600 text-pretty line-clamp-2">{seccion.description}</p>
</a>
