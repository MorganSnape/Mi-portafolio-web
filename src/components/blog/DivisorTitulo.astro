---
// Línea — [ Título ] — línea, como en los bocetos.
interface Props {
  titulo: string
  id?: string
  nivel?: 'h2' | 'h3'
  class?: string
}

const { titulo, id, nivel = 'h2',class: className } = Astro.props
---
<div id={id} class={`w-full relative h-2 flex items-center z-20 my-20 ${className}`}>
  <h2
    class={`min-w-[12rem] md:min-w-[18rem] lg:min-w-sm absolute bottom-[100%] translate-y-1/2 -translate-1/2 left-1/2`}
  >
    <div
      class={`bg-secondary w-full h-14 md:h-16 py-2 md:py-6 px-5 md:px-12 gap-4 text-center text-base md:text-lg tag-me tracking-[6px] font-bold`}
    >
      {titulo}
    </div>
  </h2>
  <div class="bg-black w-full h-2"></div>
</div>
