---
// Caja de cierre "Para repasar": resume en pocas líneas lo esencial del apunte.
// Uso en MDX (no hace falta importarlo, está en componentesMdx):
//
//   <Repaso>
//   - Primera idea clave.
//   - Segunda idea clave.
//   </Repaso>
//
// Props:
//   titulo   (opcional) rótulo de la caja. Por defecto "Para repasar".
//   variant  (opcional) "secondary" (amarillo) | "pink" | "green" | "purple" | "cream"
interface Props {
  titulo?: string
  variant?: 'secondary' | 'pink' | 'green' | 'purple' | 'cream'
  class?: string
}

const { titulo = 'Para repasar', variant = 'pink', class: className = '' } = Astro.props

// Clases completas para que Tailwind las detecte
const fondos = {
  secondary: 'bg-secondary',
  pink: 'bg-pink',
  green: 'bg-plant-green',
  purple: 'bg-trendy-pink-200',
  cream: 'bg-white-cream',
} as const
---

<aside
  class:list={[
    'not-prose relative my-14 rounded-ventana border-2 border-black px-6 pb-6 pt-9 text-black shadow-dura-abajo md:px-10 md:pb-8 md:shadow-dura-abajo-lg',
    fondos[variant],
    className,
  ]}
>
  <span
    class="absolute -top-4 left-6 rounded-full border-2 border-black bg-white px-4 py-1 text-sm font-bold shadow-dura-sm md:left-10"
  >
    {titulo}
  </span>
  <div class="[&>*:last-child]:mb-0! [&_li]:marker:font-bold">
    <slot />
  </div>
</aside>
