---
// Reemplaza automáticamente cada bloque ```código``` del MDX.
// Shiki entrega el <pre> con su clase, colores y data-language: se conservan con {...rest}.
const { class: className, ...rest } = Astro.props
---

<div class="my-4 bg-white border-2 border-black rounded-xl md:rounded-2xl overflow-hidden">
  <div class="h-10 flex flex-row items-center gap-2 px-4 border-b-4 border-black">
    <span class="h-3 w-3 bg-black rounded-full"></span>
    <span class="h-3 w-3 bg-black rounded-full"></span>
    <span class="h-3 w-3 bg-black rounded-full"></span>
  </div>
  <pre class:list={[className, 'p-4 text-sm']} {...rest}><slot /></pre>
</div>
