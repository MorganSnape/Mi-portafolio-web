---
/**
 * LinkButton — tarjeta/botón de enlace neo-brutalista para artículos de blog.
 *
 * Uso en .astro / .mdx:
 *   <LinkButton href="https://zajuna.sena.edu.co/login" description="Plataforma donde subo mis evidencias del SENA" />
 *
 * Descripción como contenido (.mdx):
 *   <LinkButton href="https://zajuna.sena.edu.co">
 *     Aquí encuentras el curso que menciono en este artículo.
 *   </LinkButton>
 *
 * Props:
 *   href         (obligatorio) URL completa
 *   description  (opcional)    texto personalizado; también se puede pasar como slot
 *   title        (opcional)    reemplaza el dominio mostrado en negrita
 *   class        (opcional)    clases extra
 *
 * Depende de la clase `.tag-me` definida en global.css
 * (borde negro, sombra dura y efecto de "presionar" en hover).
 */
interface Props {
  href: string;
  description?: string;
  title?: string;
  class?: string;
}

const { href, description, title, class: className = "" } = Astro.props;

let hostname = href;
let isExternal = true;

try {
  const url = new URL(href);
  hostname = url.hostname.replace(/^www\./, "");
  isExternal = /^https?:$/.test(url.protocol);
} catch {
  isExternal = false;
}

const hasDescription = Boolean(description) || Astro.slots.has("default");
---

<a
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  class:list={[
    "tag-me group not-prose my-6 block w-full max-w-md overflow-hidden rounded-lg",
    "bg-white-cream text-black no-underline",
    "focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-primary",
    className,
  ]}
>
  <!-- Dominio + parte del enlace -->
  <div class="flex items-center gap-4 px-4 py-4">
    <div class="min-w-0 flex-1">
      <p class="font-fantabular truncate text-lg font-bold md:text-xl">
        {title ?? hostname}
      </p>
      <p class="font-rethink truncate text-sm text-gray-500" title={href}>
        {href}
      </p>
    </div>

    <!-- Flecha dentro del círculo rosa -->
    <span
      class="flex size-10 shrink-0 items-center justify-center rounded-full border-2 border-black bg-pink transition-colors duration-150 group-hover:bg-secondary"
      aria-hidden="true"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-5"
      >
        <path d="M7 17 17 7"></path>
        <path d="M7 7h10v10"></path>
      </svg>
    </span>
  </div>

  <!-- Descripción personalizable (prop o slot) -->
  {
    hasDescription && (
      <p class="font-rethink border-t-2 border-black bg-secondary px-4 py-3 text-sm leading-relaxed font-medium">
        {description}
        <slot />
      </p>
    )
  }
</a>