---
/**
 * LinkButton — tarjeta/botón de enlace para artículos de blog.
 *
 * Uso en .astro:
 *   <LinkButton href="https://zajuna.sena.edu.co/login" description="Plataforma donde subo mis evidencias del SENA" />
 *
 * Uso en .mdx (descripción como contenido):
 *   <LinkButton href="https://zajuna.sena.edu.co">
 *     Aquí encuentras el curso que menciono en este artículo.
 *   </LinkButton>
 *
 * Props:
 *   href         (obligatorio) URL completa del enlace
 *   description  (opcional)    texto personalizado; también se puede pasar como slot
 *   title        (opcional)    reemplaza el dominio mostrado en negrita
 *   class        (opcional)    clases extra de Tailwind
 */
interface Props {
  href: string;
  description?: string;
  title?: string;
  class?: string;
}

const { href, description, title, class: className = "" } = Astro.props;

let hostname = href;
let isExternal = true;

try {
  const url = new URL(href);
  hostname = url.hostname.replace(/^www\./, "");
  isExternal = /^https?:$/.test(url.protocol);
} catch {
  // href relativo o inválido: se muestra tal cual
  isExternal = false;
}

const hasSlot = Astro.slots.has("default");
const hasDescription = Boolean(description) || hasSlot;
---

<a
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  class:list={[
    "group not-prose my-4 flex w-full max-w-md items-center gap-4 rounded-2xl",
    "border border-neutral-800 bg-neutral-900 px-6 py-5 no-underline",
    "transition-colors duration-200 hover:border-neutral-600 hover:bg-neutral-800",
    "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white",
    className,
  ]}
>
  <div class="min-w-0 flex-1">
    <!-- Dominio / título en negrita -->
    <p class="truncate text-lg font-bold text-white">
      {title ?? hostname}
    </p>

    <!-- Parte del enlace, truncada con "…" -->
    <p class="truncate text-sm text-neutral-400" title={href}>
      {href}
    </p>

    <!-- Descripción personalizable (prop o slot) -->
    {
      hasDescription && (
        <p class="mt-3 border-t border-neutral-800 pt-3 text-sm leading-relaxed text-neutral-300">
          {description}
          <slot />
        </p>
      )
    }
  </div>

  <!-- Flecha -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="size-5 shrink-0 text-neutral-500 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-white"
    aria-hidden="true"
  >
    <path d="M7 17 17 7"></path>
    <path d="M7 7h10v10"></path>
  </svg>
</a>
