---
// Recuadro para destacar una fórmula o una regla corta de repaso.
// Uso en MDX (no hace falta importarlo, está en componentesMdx):
//
//   <Formula titulo="Costo total">
//   CT = CF + CV
//   </Formula>
//
// Debajo de la fórmula puedes escribir la leyenda en Markdown normal
// (por ejemplo, una lista "CT = costo total").
interface Props {
  titulo?: string
  class?: string
}

const { titulo, class: className = '' } = Astro.props
---

<div
  class:list={[
    'not-prose my-8 rounded-tarjeta border-2 border-black bg-white-cream px-5 py-5 text-black shadow-dura md:px-8 md:shadow-dura-lg',
    className,
  ]}
>
  {
    titulo && (
      <p class="m-0! mb-3! inline-block rounded-full border-2 border-black bg-secondary px-3 py-0.5 text-xs! font-bold! uppercase tracking-wider">
        {titulo}
      </p>
    )
  }
  <div
    class="font-fantabular text-xl font-bold md:text-2xl [&_p]:m-0! [&_p]:text-[1em]! [&_p]:font-bold! [&_ul]:mt-3 [&_ul]:font-rethink [&_ul]:text-base [&_ul]:font-normal [&_li]:text-[length:var(--text-base)]! [&_li]:font-normal!"
  >
    <slot />
  </div>
</div>
