---
// Imagen grande (mapas, diagramas) que se abre en tamaño completo dentro de la página.
// Uso en MDX:
//   import mapa from "./mapa.png";
//   <ImagenAmpliable src={mapa} alt="…" />
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  src: ImageMetadata
  alt: string
  textoBoton?: string
}

const { src, alt, textoBoton = 'Ver en tamaño completo' } = Astro.props
const id = `ampliar-${Math.random().toString(36).slice(2, 9)}`
---

<figure class="not-prose my-8 flex flex-col items-start gap-4">
  <button type="button" data-abrir={id} class="block w-full cursor-zoom-in" aria-label={`${textoBoton}: ${alt}`}>
    <Image src={src} alt={alt} class="w-full h-auto border-2 border-black" />
  </button>
  <button
    type="button"
    data-abrir={id}
    class="efecto-hundir border-2 border-black rounded-full bg-white px-4 py-2 text-sm font-semibold text-black"
  >
    {textoBoton}
  </button>
</figure>

<dialog id={id} class="ampliable m-auto h-[92vh] w-[96vw] max-w-none rounded-tarjeta border-2 border-black bg-white-cream p-0 backdrop:bg-black/70">
  <div class="sticky top-0 z-10 flex items-center justify-between gap-4 border-b-2 border-black bg-white-cream px-4 py-3">
    <p class="truncate text-sm font-semibold text-black">{alt}</p>
    <div class="flex shrink-0 gap-2">
      <a href={src.src} target="_blank" rel="noopener" class="rounded-full border-2 border-black bg-white px-3 py-1 text-sm font-semibold text-black hover:bg-secondary">Abrir imagen</a>
      <button type="button" data-cerrar class="rounded-full border-2 border-black bg-pink px-3 py-1 text-sm font-semibold text-black">Cerrar</button>
    </div>
  </div>
  <div class="overflow-auto p-4">
    <img src={src.src} alt={alt} width={src.width} height={src.height} loading="lazy" class="h-auto min-w-[1100px] w-full" />
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-abrir]').forEach(boton => {
    if (boton.dataset.listo) return
    boton.dataset.listo = '1'
    boton.addEventListener('click', () => {
      const dialogo = document.getElementById(boton.dataset.abrir!) as HTMLDialogElement | null
      dialogo?.showModal()
    })
  })
  document.querySelectorAll<HTMLDialogElement>('dialog.ampliable').forEach(dialogo => {
    if (dialogo.dataset.listo) return
    dialogo.dataset.listo = '1'
    dialogo.querySelector('[data-cerrar]')?.addEventListener('click', () => dialogo.close())
    // Cierra al hacer clic fuera de la ventana
    dialogo.addEventListener('click', e => {
      if (e.target === dialogo) dialogo.close()
    })
  })
</script>
