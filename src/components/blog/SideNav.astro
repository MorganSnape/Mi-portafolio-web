---
// Índice del apunte: recibe los títulos ya calculados en el servidor,
// así que no necesita JavaScript en el navegador.
import type { MarkdownHeading } from 'astro'
import { Icon } from 'astro-icon/components'
import Etiqueta from '@/components/ui/Etiqueta.astro'

interface Props {
  headings: MarkdownHeading[]
  volver?: { href: string; texto: string }
  class?: string
}

const { headings, volver = { href: '/blog', texto: 'Inicio de Blog' }, class: className = '' } = Astro.props
const titulos = headings.filter(heading => heading.depth === 2)
---

<aside
  class:list={[
    'sticky top-0 h-screen w-64 shrink-0 self-start overflow-y-auto bg-black-secondary p-4 text-white-cream',
    className,
  ]}
>
  <a
    href={volver.href}
    class="flex items-center gap-2 rounded-full border-2 border-black bg-white px-4 py-2 text-black text-sm font-semibold leading-tight transition-colors duration-150 hover:bg-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
  >
    <Icon name="fa6-solid:arrow-left" width={14} height={14} class="shrink-0" aria-hidden="true" />
    {volver.texto}
  </a>
  {
    titulos.length > 0 && (
      <nav aria-label="Contenido del apunte" class="mt-6">
        <Etiqueta color="amarillo" mayusculas>En este apunte</Etiqueta>
        <ul class="mt-3 flex flex-col gap-1">
          {titulos.map(titulo => (
            <li>
              <a
                href={`#${titulo.slug}`}
                class="block rounded-xl px-3 py-1.5 text-sm font-semibold leading-snug transition-colors duration-150 hover:text-secondary focus-visible:outline-2 focus-visible:outline-secondary"
              >
                {titulo.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</aside>
