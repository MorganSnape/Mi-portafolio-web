---
// Botones "Anterior" y "Siguiente" al final de cada artículo del blog.
// Usan el componente Button (píldora con borde, tono claro para el fondo
// claro de la página) y debajo muestran el título del apunte al que llevan.
import { Icon } from 'astro-icon/components'
import Button from '@/components/Button.astro'
import { urlPost, type Post } from '@/utils/blog'

interface Props {
  anterior?: Post
  siguiente?: Post
  class?: string
}

const { anterior, siguiente, class: className = '' } = Astro.props
---

{
  (anterior || siguiente) && (
    <nav aria-label="Navegación entre apuntes" class:list={['flex w-full items-start justify-between gap-4', className]}>
      {anterior ? (
        <div class="flex min-w-0 max-w-[48%] flex-col items-start gap-2">
          <Button
            href={urlPost(anterior)}
            text="Anterior"
            typeIcon
            tono="claro"
            iconoAntes
            rel="prev"
            ariaLabel={`Apunte anterior: ${anterior.data.title}`}
          >
            <Icon name="fa6-solid:arrow-left" width={14} height={14} />
          </Button>
          <span class="line-clamp-2 pl-2 text-xs md:text-sm text-black-secondary" aria-hidden="true">
            {anterior.data.title}
          </span>
        </div>
      ) : (
        <span />
      )}
      {siguiente && (
        <div class="flex min-w-0 max-w-[48%] flex-col items-end gap-2 text-right">
          <Button
            href={urlPost(siguiente)}
            text="Siguiente"
            typeIcon
            tono="claro"
            rel="next"
            ariaLabel={`Siguiente apunte: ${siguiente.data.title}`}
          >
            <Icon name="fa6-solid:arrow-right" width={14} height={14} />
          </Button>
          <span class="line-clamp-2 pr-2 text-xs md:text-sm text-black-secondary" aria-hidden="true">
            {siguiente.data.title}
          </span>
        </div>
      )}
    </nav>
  )
}
