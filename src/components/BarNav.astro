---
import { Icon } from "astro-icon/components";
import Logo from "public/isotipo-negativo.svg";

import { navLinks } from "@/data/navLinks";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const isCurrentLink = (href: string) => {
  const normalizedHref = new URL(href, Astro.url).pathname.replace(/\/$/, "") || "/";

  if (normalizedHref === "/") {
    return currentPath === "/" || currentPath.startsWith("/proyectos/");
  }

  return currentPath === normalizedHref;
};
---

<header class="fixed top-0 z-50 bg-black-secondary w-full shadow-sm">
  <nav class="mx-auto lg:w-11/12 max-w-[1280px] w-fullmx-auto flex items-center justify-between h-[var(--altura-header)] px-6">
    <a href="/" aria-label="Inicio, Gabriela Ferrer">
      <Logo class="h-10 fill-white" aria-hidden="true" />
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="z-50 p-2 text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-300 lg:hidden"
      aria-label="Menú principal"
      aria-controls="primary-navigation"
      aria-expanded="false"
    >
      <Icon name="codicon:menu" class="text-3xl" aria-hidden="true" />
    </button>

    <ul
      id="primary-navigation"
      class="hidden fixed inset-x-0 top-[var(--altura-header)] z-40 min-h-[calc(100dvh-var(--altura-header))] flex-col items-center justify-center gap-4 overflow-y-auto bg-black-secondary px-0 lg:static lg:flex lg:min-h-0 lg:flex-row lg:justify-end lg:gap-0 lg:overflow-visible lg:bg-transparent"
    >
      {
        navLinks.map((link) => (
          <li class="w-full lg:w-fit">
            <a
              href={link.href}
              class:list={[
                "nav-item font-rethink w-full px-4 text-center lg:text-left text-white text-lg lg:text-base font-normal hover:text-gray-400 focus:ring-2 active:font-semibold active:text-white active:border-none focus:outline-none h-[calc(var(--altura-header)_-_12px)] focus:ring-yellow-300 flex flex-col items-center justify-center",
                { active: isCurrentLink(link.href) },
              ]}
              aria-current={isCurrentLink(link.href) ? 'page' : undefined}
            >
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('header')
  const menuButton = document.querySelector<HTMLButtonElement>('#menu-toggle')
  const primaryNavigation = document.querySelector<HTMLUListElement>(
    '#primary-navigation',
  )

  let lastScrollY = window.scrollY

  const showHeader = () => {
    header?.classList.remove('scroll-hidden')
  }

  window.addEventListener(
    'scroll',
    () => {
      const currentScrollY = window.scrollY
      const isMenuExpanded =
        menuButton?.getAttribute('aria-expanded') === 'true'

      if (currentScrollY <= 10 || isMenuExpanded) {
        showHeader()
        lastScrollY = currentScrollY
        return
      }

      if (Math.abs(currentScrollY - lastScrollY) < 8) return

      header?.classList.toggle('scroll-hidden', currentScrollY > lastScrollY)
      lastScrollY = currentScrollY
    },
    { passive: true },
  )

  if (menuButton && primaryNavigation) {
    const closeMenu = () => {
      menuButton.setAttribute('aria-expanded', 'false')
      primaryNavigation.classList.add('hidden')
      lastScrollY = window.scrollY
    }

    menuButton.addEventListener('click', () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true'
      menuButton.setAttribute('aria-expanded', String(!isExpanded))
      primaryNavigation.classList.toggle('hidden', isExpanded)
      if (!isExpanded) showHeader()
    })

    primaryNavigation.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu)
    })

    document.addEventListener('keydown', event => {
      if (
        event.key === 'Escape' &&
        menuButton.getAttribute('aria-expanded') === 'true'
      ) {
        closeMenu()
        menuButton.focus()
      }
    })
  }
</script>

<style>
  header {
    transition: transform 200ms ease-in-out;
  }

  header.scroll-hidden {
    transform: translateY(-100%);
    pointer-events: none;
  }

  .nav-item.active {
    font-weight: 700;
    color: var(--color-secondary, #ffe971);
    border-bottom: 3px solid var(--color-secondary, #ffe971);
  }

  @media (prefers-reduced-motion: reduce) {
    header {
      transition: none;
    }
  }
</style>
