---
import { Icon } from "astro-icon/components";
import Logo from "public/isotipo-negativo.svg";

import { navLinks } from "@/data/navLinks";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const isCurrentLink = (href: string) => {
  const normalizedHref = href.replace(/\/$/, "") || "/";

  if (normalizedHref === "/") {
    return currentPath === "/" || currentPath.startsWith("/proyectos/");
  }

  return currentPath === normalizedHref;
};
---

<header class="fixed top-0 z-50 bg-black-secondary w-full">
  <nav class="max-w-[1440px] mx-auto flex items-center justify-between px-4 lg:px-6 h-[var(--altura-header)]">
    <a href="/">
      <Logo class="h-10 fill-white" />
    </a>

    <!-- Botón hamburguesa -->
    <label for="menu-hamburguer" class="lg:hidden z-50">
      <Icon name="codicon:menu" class="text-3xl text-white" />
    </label>
    <input type="checkbox" id="menu-hamburguer" class="hidden peer" />

    <!-- Links -->  
    <ul
      class="fixed lg:static inset-x-0 left-0 right-0 top-[var(--altura-header)] bottom-0 lg:bottom-auto lg:top-0 bg-black-secondary lg:bg-transparent
      flex flex-col lg:flex-row items-center lg:items-center justify-start peer-checked:justify-center max-h-0 peer-checked:max-h-none overflow-hidden lg:overflow-visible transition-all duration-300 ul-links box-border px-0 h-full lg:h-auto space-y-4 lg:space-y-0 lg:space-x-4"
    >
      {
        navLinks.map((link) => (
          <li class="w-full lg:w-fit">
            <a
              href={link.href}
              class:list={[
                "nav-item font-rethink w-full px-4 text-center lg:text-left text-white text-lg lg:text-base font-normal hover:text-gray-400 focus:ring-2 active:font-semibold active:text-white active:border-none focus:outline-none h-[calc(var(--altura-header)_-_12px)] focus:ring-yellow-300 flex flex-col items-center justify-center",
                { active: isCurrentLink(link.href) },
              ]}
            >
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .nav-item.active {
    font-weight: 700;
    color: var(--color-secondary, #ffe971);
    border-bottom: 3px solid var(--color-secondary, #ffe971);
  }
</style>
