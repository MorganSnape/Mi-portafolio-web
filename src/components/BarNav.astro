---
import { Icon } from 'astro-icon/components'
import Logo from 'public/isotipo-negativo.svg'

import { navLinks } from '@/data/navLinks'

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'

const isCurrentLink = (href: string) => {
  const normalizedHref =
    new URL(href, Astro.url).pathname.replace(/\/$/, '') || '/'

  if (normalizedHref === '/') {
    return currentPath === '/' || currentPath.startsWith('/proyectos/')
  }

  return currentPath === normalizedHref
}
---

<header
  class="fixed top-0 z-50 bg-black-secondary w-full shadow-sm border-b-2 border-black"
>
  <nav
    aria-label="Principal"
    class="mx-auto w-full lg:w-11/12 max-w-sitio flex items-center justify-between h-[var(--altura-header)] px-6 lg:px-0"
  >
    <a
      href="/"
      aria-label="Inicio, Gabriela Ferrer"
      class="rounded-chico transition-transform duration-200 hover:-rotate-6 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary motion-reduce:transition-none"
    >
      <Logo class="h-10 fill-white" aria-hidden="true" />
    </a>

    <!-- Botón del menú en celular: cambia de ☰ a ✕ según aria-expanded -->
    <button
      id="menu-toggle"
      type="button"
      class="group z-50 grid place-items-center size-11 rounded-full border-2 border-white-cream/40 text-white transition-colors duration-150 hover:border-secondary hover:text-secondary aria-expanded:border-secondary aria-expanded:text-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary lg:hidden"
      aria-label="Menú principal"
      aria-controls="primary-navigation"
      aria-expanded="false"
    >
      <Icon
        name="codicon:menu"
        class="text-2xl group-aria-expanded:hidden"
        aria-hidden="true"
      />
      <Icon
        name="codicon:close"
        class="hidden text-2xl group-aria-expanded:block"
        aria-hidden="true"
      />
    </button>

    <ul
      id="primary-navigation"
      class="hidden fixed inset-x-0 top-[var(--altura-header)] z-40 h-[calc(100dvh-var(--altura-header))] flex-col items-center justify-center gap-6 overflow-y-auto bg-black-secondary bg-[url(/fondoDos.svg)] bg-[length:30px]
             lg:static lg:flex lg:h-auto lg:flex-row lg:justify-end lg:gap-2 lg:overflow-visible lg:bg-none lg:bg-transparent"
    >
      {
        navLinks.map(link => {
          const actual = isCurrentLink(link.href)
          return (
            <li>
              <a
                href={link.href}
                aria-current={actual ? 'page' : undefined}
                class:list={[
                  // Base: texto claro y una raya amarilla debajo que crece al pasar el cursor
                  'relative flex items-center px-4 py-2 font-rethink text-2xl lg:text-base rounded-full transition-colors duration-150',
                  "after:absolute after:inset-x-4 after:bottom-0.5 after:h-[3px] after:rounded-full after:bg-secondary after:origin-left after:transition-transform after:duration-200 after:content-['']",
                  'hover:text-secondary hover:after:scale-x-100 motion-reduce:after:transition-none',
                  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary',
                  // Página actual: amarillo, en negrita y con la raya visible
                  actual
                    ? 'text-secondary font-bold after:scale-x-100'
                    : 'text-white font-medium after:scale-x-0',
                ]}
              >
                {link.name}
              </a>
            </li>
          )
        })
      }
      <!-- Botón a la hoja de vida: cuadro amarillo con ícono de documento, del tamaño
           de los botones de redes. En escritorio es solo ícono y al pasar el cursor
           (o con Tab) muestra la etiqueta "Hoja de vida". En el menú del celular,
           donde no hay cursor, el texto se ve al lado del ícono. -->
      <li class="mt-4 lg:mt-0 lg:ml-4">
        <a
          href="/curriculum"
          aria-current={currentPath === '/curriculum' ? 'page' : undefined}
          class="group/cv relative flex h-10 lg:w-10 items-center justify-center gap-2 px-4 lg:px-0 rounded-chico bg-secondary text-black font-rethink font-bold text-lg transition-[scale,filter] duration-200 ease-in-out hover:scale-105 hover:brightness-95 aria-[current=page]:ring-2 aria-[current=page]:ring-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary motion-reduce:transition-none"
        >
          <span class="lg:sr-only">Currículum</span>
          <Icon name="fa6-solid:file-lines" class="size-5" aria-hidden="true" />
          <!-- Etiqueta flotante (solo escritorio) -->
          <span
            aria-hidden="true"
            class="pointer-events-none absolute top-full right-0 mt-2 hidden lg:block whitespace-nowrap rounded-chico bg-black px-3 py-1 text-xs font-semibold text-white-cream opacity-0 -translate-y-1 transition-[opacity,translate] duration-150 group-hover/cv:opacity-100 group-hover/cv:translate-y-0 group-focus-visible/cv:opacity-100 group-focus-visible/cv:translate-y-0"
          >
            Currículum
          </span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('header')
  const menuButton = document.querySelector<HTMLButtonElement>('#menu-toggle')
  const primaryNavigation = document.querySelector<HTMLUListElement>(
    '#primary-navigation',
  )

  let lastScrollY = window.scrollY

  const setHeaderHidden = (hidden: boolean) => {
    header?.classList.toggle('scroll-hidden', hidden)
    document.documentElement.classList.toggle('header-hidden', hidden)
  }

  const showHeader = () => {
    setHeaderHidden(false)
  }

  window.addEventListener(
    'scroll',
    () => {
      const currentScrollY = window.scrollY
      const isMenuExpanded =
        menuButton?.getAttribute('aria-expanded') === 'true'

      if (currentScrollY <= 10 || isMenuExpanded) {
        showHeader()
        lastScrollY = currentScrollY
        return
      }

      if (Math.abs(currentScrollY - lastScrollY) < 8) return

      setHeaderHidden(currentScrollY > lastScrollY)
      lastScrollY = currentScrollY
    },
    { passive: true },
  )

  if (menuButton && primaryNavigation) {
    // Con el menú abierto en celular, la página de atrás no se desplaza
    const setMenuOpen = (open: boolean) => {
      menuButton.setAttribute('aria-expanded', String(open))
      // hidden y flex van juntos: sin flex, el menú abierto queda como bloque y no se centra
      primaryNavigation.classList.toggle('hidden', !open)
      primaryNavigation.classList.toggle('flex', open)
      document.documentElement.classList.toggle('overflow-hidden', open)
      if (open) showHeader()
    }

    const closeMenu = () => {
      setMenuOpen(false)
      lastScrollY = window.scrollY
    }

    menuButton.addEventListener('click', () => {
      setMenuOpen(menuButton.getAttribute('aria-expanded') !== 'true')
    })

    // Si se agranda la ventana a escritorio con el menú abierto, se cierra
    window.matchMedia('(min-width: 64rem)').addEventListener('change', e => {
      if (e.matches) closeMenu()
    })

    primaryNavigation.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu)
    })

    document.addEventListener('keydown', event => {
      if (
        event.key === 'Escape' &&
        menuButton.getAttribute('aria-expanded') === 'true'
      ) {
        closeMenu()
        menuButton.focus()
      }
    })
  }
</script>

<style>
  header {
    transition: transform 200ms ease-in-out;
  }

  header.scroll-hidden {
    transform: translateY(-100%);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    header {
      transition: none;
    }
  }
</style>
