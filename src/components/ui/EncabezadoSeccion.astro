---
// Encabezado de sección del sistema: etiqueta en píldora + título grande
// en Fantabular + descripción opcional. Hereda el color de texto del panel.
import Etiqueta from './Etiqueta.astro'

interface Props {
  etiqueta?: string
  titulo: string
  descripcion?: string
  /** id del título, para aria-labelledby y anclas */
  id?: string
  nivel?: 'h1' | 'h2'
  alinear?: 'centro' | 'izquierda'
  class?: string
}

const {
  etiqueta,
  titulo,
  descripcion,
  id,
  nivel: Titulo = 'h2',
  alinear = 'centro',
  class: className = '',
} = Astro.props
const centrado = alinear === 'centro'
---

<header class:list={['flex flex-col gap-4', centrado ? 'items-center text-center' : 'items-start', className]}>
  {etiqueta && <Etiqueta color="negro" mayusculas>{etiqueta}</Etiqueta>}
  <Titulo
    id={id}
    class:list={[
      'scroll-mt-24',
      Titulo === 'h1' ? 'titulo-portada' : 'font-fantabular font-black text-6xl leading-[0.9] text-balance',
    ]}
  >
    {titulo}
  </Titulo>
  {descripcion && <p class:list={['max-w-2xl text-lg md:text-xl font-medium text-pretty', { 'mx-auto': centrado }]}>{descripcion}</p>}
</header>
