---
import { proyectos } from '@/data/portfolio'


import Card from '@/components/Card.astro'
import ProyectosContainer from '@/components/ProyectosContainer.astro'

const buttonClass =
  'cursor-pointer hover:scale-105 gap-2 flex flex-row justify-center items-center transition-all duration-150 ease-in-out select-none border-2 border-black font-medium translate-0 text-base'
---

<!-- Sin márgenes externos: la separación vertical la pone la caja (gap-20)
     y los márgenes laterales el carril de index.astro -->
<section
  id="proyectos-container"
  class="w-full scroll-mt-28"
>
  <div class="w-full flex flex-col gap-12 md:gap-20">
    <p class="text-base md:text-lg font-normal font-fantabular">
      <span class="font-black text-2xl">
        Cada proyecto muestra cómo trabajo:
      </span>
      <br />
      el reto de la marca, las decisiones que tomé y el resultado.
    </p>
    <!-- <div
      class="w-full justify-center flex flex-row flex-wrap gap-4 md:gap-6 items-center py-10"
    >
      <button class={`${buttonClass} filter-button`} data-filter="all">
        Todos
        <Icon
          name="codicon:check-all"
          height={20}
          width={20}
          class="text-white"
        />
      </button>
      <button class={`${buttonClass} filter-button`} data-filter="ux"
        >UX/UI</button
      >
      <button class={`${buttonClass} filter-button`} data-filter="front"
        >Front-End</button
      >
      <button class={`${buttonClass} filter-button`} data-filter="design"
        >Diseño Gráfico</button
      >
    </div> -->
    <div id="design-projects" class="w-full">
      <div
        class="grid grid-cols-1 xl:grid-cols-2 justify-items-center xl:justify-items-stretch gap-12 w-full"
      >
        {
          proyectos.map(proyecto => (
            <div
              class="project-card w-full flex justify-center"
              data-type={proyecto.type
                .map(type => type.toLowerCase())
                .join(' ')}
            >
              <Card section={proyecto.type[0]} {...proyecto} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script type="module">
  const filterButtons = document.querySelectorAll('[data-filter]')
  const projectCards = document.querySelectorAll('.project-card')

  function updateFilter(filter) {
    const filterMap = {
      all: [],
      ux: ['ux'],
      front: ['front'],
      design: ['design', 'diseño', 'graphic', 'graphics'],
    }
    const searchTerms = filterMap[filter] || [filter]

    projectCards.forEach(card => {
      const types = (card.getAttribute('data-type') || '').split(' ')
      const isVisible =
        filter === 'all' || searchTerms.some(term => types.includes(term))
      card.classList.toggle('hidden', !isVisible)
    })
  }

  function updateActiveButton(clickedButton) {
    filterButtons.forEach(button => {
      button.classList.remove('active')
    })
    clickedButton.classList.add('active')
  }

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter || 'all'
      updateFilter(filter)
      updateActiveButton(button)
    })
  })

  if (filterButtons[0]) {
    updateActiveButton(filterButtons[0])
  }

  updateFilter('all')
</script>

<style>
  .filter-button {
    font-weight: 400;
    background: transparent;
    border: 2px solid;
    transition: all 0.1s ease-in-out;
    padding: 8px 20px;
  }
  .filter-button.active {
    background: var(--color-primary);
    border: 2px solid #000;
    color: #fff;
  }
</style>
