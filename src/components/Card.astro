---
import { type Proyect } from '@/models'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'

import Etiqueta from '@/components/ui/Etiqueta.astro'
import TagDesign from '@/assets/tag-design.svg'
import TagFrontEnd from '@/assets/tag-code.svg'
import TagDesignUX from '@/assets/tag-ux-ui.svg'

interface Props extends Proyect {
  section: 'UX' | 'Front' | 'Diseño' | null
}

const {
  slug,
  shortDescription,
  descriptionProject,
  coverImage,
  tags,
  nameProject,
  section,
  projectType,
  date,
} = Astro.props

const icons = {
  UX: TagDesignUX,
  Front: TagFrontEnd,
  Diseño: TagDesign,
} as const

const SectionIcon = icons[section as keyof typeof icons] ?? TagDesign

const summary = shortDescription || descriptionProject.split(/\n\s*\n/)[0]
const year = date.match(/\d{4}/)?.[0]
const inProgress = /en proceso/i.test(date)
const context = [projectType, year].filter(Boolean).join(' · ')

// ── Efecto del sistema de diseño ──
// Igual que .efecto-hundir border-2 border-black: la tarjeta tiene sombra dura y, al pasar el cursor o con el teclado,
// "se hunde" sobre su sombra. El sticker de la esquina se mueve con ella.
const hundir =
  'transition-[translate,rotate,box-shadow] duration-150 ease-in-out motion-reduce:transition-none ' +
  'group-hover/card:translate-1.5 group-focus-visible/card:translate-1.5'
---

<a
  href={`/proyectos/${slug}`}
  class="group/card @container relative block h-full w-full max-w-lg xl:max-w-none shrink-0 snap-start rounded-ventana focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-secondary"
>
  <SectionIcon
    aria-hidden="true"
    class={`pointer-events-none absolute right-4 -top-3 z-40 h-14 w-14
           ${hundir} group-hover/card:-rotate-6 
           @sm:h-16 @sm:w-16 @lg:-top-4 @lg:h-20 @lg:w-20`}
  />

  <article
    class={`flex h-full flex-col overflow-hidden rounded-ventana border-2 border-black bg-white-cream text-black
           shadow-dura md:shadow-dura-lg ${hundir}
           group-hover/card:shadow-none group-focus-visible/card:shadow-none @lg:aspect-[16/9]`}
  >
    <!-- Barra de navegador: la misma de <Ventana> -->
    <div
      class="relative flex h-10 shrink-0 items-center gap-2 border-b-2 border-black px-4"
      aria-hidden="true"
    >
      <span class="size-3 rounded-full bg-black"></span>
      <span class="size-3 rounded-full bg-black"></span>
      <span class="size-3 rounded-full bg-black"></span>
      <span
        class="absolute left-1/2 max-w-[50%] -translate-x-1/2 truncate rounded-full border-2 border-black bg-white
               px-3 py-0.5 text-2xs font-bold @sm:text-xs"
      >
        /{slug}
      </span>
    </div>

    <!-- Cuerpo: apilado en móvil, horizontal desde 32rem de contenedor -->
    <div
      class="flex min-h-0 flex-1 flex-col gap-3 p-3 @lg:flex-row @lg:items-stretch @lg:gap-5 @lg:p-4"
    >
      <figure
        class="relative m-0 h-40 w-full shrink-0 overflow-hidden rounded-tarjeta border-2 border-black bg-white
               @sm:h-48 @lg:h-auto @lg:w-[44%]"
      >
        <Image
          src={coverImage}
          alt=""
          width={coverImage.width}
          height={coverImage.height}
          class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-300 ease-out
                 group-hover/card:scale-105 motion-reduce:transition-none"
        />
        {
          inProgress && (
            <figcaption class="absolute bottom-2 left-2 @sm:bottom-3 @sm:left-3">
              <Etiqueta color="amarillo">En proceso</Etiqueta>
            </figcaption>
          )
        }
      </figure>

      <div class="flex min-h-0 min-w-0 flex-1 flex-col gap-2">
        <h3
          class="line-clamp-2 font-fantabular text-xl font-bold leading-tight text-balance @sm:text-2xl"
        >
          {nameProject}
        </h3>

        {
          tags && tags.length > 0 && (
            <ul class="flex flex-wrap gap-1.5" aria-label="Disciplinas">
              {tags.map(tag => (
                <li class="text-gray-400">
                  {tag} /
                </li>
              ))}
            </ul>
          )
        }

        <p
          class="line-clamp-2 text-pretty text-sm leading-snug text-black-secondary @md:line-clamp-3 @lg:line-clamp-4"
        >
          {summary}
        </p>

        <div
          class="mt-auto flex flex-wrap items-center justify-end gap-2 pt-2"
        >
          <span
            class="hidden sm:flex size-9 shrink-0 items-center justify-center rounded-full border-2 border-black bg-pink transition-colors duration-150 group-hover/card:bg-secondary"
            aria-hidden="true"
          >
            <Icon
              name="fa6-solid:arrow-up"
              width={14}
              height={14}
              class="rotate-45"
            />
          </span>
        </div>
      </div>
    </div>
  </article>
</a>
