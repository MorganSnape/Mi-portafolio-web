---
import { type Proyect } from '@/models'
import { Image } from 'astro:assets'

import TagDesign from '@/assets/tag-design.svg'
import TagFrontEnd from '@/assets/tag-code.svg'
import TagDesignUX from '@/assets/tag-ux-ui.svg'
import ArrowIcon from '@/assets/flecha.svg'

interface Props extends Proyect {
  section: 'UX' | 'Front' | 'Diseño' | null
}

const {
  slug,
  shortDescription,
  descriptionProject,
  coverImage,
  tags,
  nameProject,
  section,
  projectType,
} = Astro.props

const icons = {
  UX: TagDesignUX,
  Front: TagFrontEnd,
  Diseño: TagDesign,
} as const

const SectionIcon = icons[section as keyof typeof icons] ?? TagDesign

// La card muestra la frase corta; si un proyecto no la tiene, usa el primer párrafo
const summary = shortDescription || descriptionProject.split(/\n\s*\n/)[0]
---

<a
  href={`/proyectos/${slug}`}
 class="group/card @container relative block h-full w-[min(32rem,calc(100vw-3rem))] xl:w-full shrink-0 snap-start rounded-xl md:rounded-2xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black"
  aria-label={`Ver proyecto: ${nameProject}`}
>
  <SectionIcon
    aria-hidden="true"
    class="pointer-events-none absolute right-4 -top-3 z-40 h-14 w-14 drop-shadow-md
           transition-transform duration-300 group-hover/card:-rotate-6 group-hover/card:scale-105
           @sm:h-16 @sm:w-16 @lg:-top-4 @lg:h-20 @lg:w-20"
  />

  <article
    +    class="flex flex-col overflow-hidden rounded-xl md:rounded-2xl border-2 border-black bg-white
+           shadow-[5px_5px_0_#000] @lg:aspect-[16/9]"
  >
    <!-- Barra superior tipo navegador -->
    <div
      class="relative flex h-9 shrink-0 flex-row items-center border-b-2 border-black bg-[#FEF7F5] px-3
             @sm:h-10 @sm:px-4"
    >
      <div class="flex flex-row items-center gap-1.5">
        <div class="h-2.5 w-2.5 rounded-full border-[1.5px] border-black bg-pink @sm:h-3 @sm:w-3"></div>
        <div class="h-2.5 w-2.5 rounded-full border-[1.5px] border-black bg-secondary @sm:h-3 @sm:w-3"></div>
        <div class="h-2.5 w-2.5 rounded-full border-[1.5px] border-black bg-primary @sm:h-3 @sm:w-3"></div>
      </div>
      <p
        class="absolute left-1/2 max-w-[50%] -translate-x-1/2 truncate rounded-full border border-black/15
               bg-white px-2 py-0.5 text-[0.65rem] font-semibold text-primary @sm:px-3 @sm:text-xs"
      >
        /{slug}
      </p>
    </div>

    <!-- Cuerpo: apilado en móvil, horizontal desde 32rem de contenedor -->
    <div
      class="flex min-h-0 flex-1 flex-col gap-3 p-3
             @lg:flex-row @lg:items-stretch @lg:gap-5 @lg:p-4"
    >
      <figure
         class="relative m-0 h-40 w-full shrink-0 overflow-hidden rounded-lg border-2 border-black bg-neutral-100
+               @sm:h-48 @lg:h-auto @lg:w-[44%]"
      >
        <Image
          src={coverImage}
          alt={`Portada del proyecto ${nameProject}`}
          width={coverImage.width}
          height={coverImage.height}
         class="absolute inset-0 h-full w-full object-cover object-center transition-transform
+                 duration-500 ease-out group-hover/card:scale-110"
        />
        {
          tags?.[0] && (
            <figcaption class="absolute bottom-2 left-2 @sm:bottom-3 @sm:left-3">
              <span class="block w-fit rounded-full border-[1.5px] border-black bg-secondary px-2.5 py-0.5 text-[0.65rem] font-semibold text-black @sm:px-3 @sm:text-xs">
                {tags[0]}
              </span>
            </figcaption>
          )
        }
      </figure>

      <div class="flex min-h-0 min-w-0 flex-1 flex-col gap-2">
        <div class="flex flex-col gap-0.5">
          <h3 class="line-clamp-2 text-lg font-bold leading-tight @sm:text-xl @lg:text-2xl">
            {nameProject}
          </h3>
          {
            projectType && (
              <p class="font-fantabular text-sm font-light italic opacity-75 @sm:text-base @lg:text-lg">
                {projectType}
              </p>
            )
          }
        </div>

        <p class="line-clamp-2 text-pretty text-sm leading-snug text-black/80 @md:line-clamp-3">
          {summary}
        </p>

        <div class="mt-auto flex justify-end pt-2">
          <span
            aria-hidden="true"
            class="primaryButton flex flex-row items-center gap-2 bg-white px-3 py-1.5 text-left text-xs
                   @sm:px-4 @sm:py-2 @sm:text-sm font-medium"
          >
            Ver proyecto
            <ArrowIcon
              class="w-5 -rotate-45 transition-transform duration-200 ease-in-out group-hover/card:rotate-0 @sm:w-6"
            />
          </span>
        </div>
      </div>
    </div>
  </article>
</a>

<style>
  @media (prefers-reduced-motion: reduce) {
    a,
    a * {
      transition: none !important;
    }
  }
</style>