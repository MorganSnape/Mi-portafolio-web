---
import { type Proyect } from '@/models'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

import TagDesign from '@/assets/tag-design.svg'
import TagFrontEnd from '@/assets/tag-code.svg'
import TagDesignUX from '@/assets/tag-ux-ui.svg'
import ArrowIcon from '@/assets/flecha.svg'

interface Props extends Proyect {
  section: 'UX' | 'Front' | 'Diseño' | null
}

const {
  slug,
  descriptionProject,
  coverImage,
  tags,
  nameProject,
  section,
  projectType,
} = Astro.props

const icons = {
  UX: TagDesignUX,
  Front: TagFrontEnd,
  Diseño: TagDesign,
} as const

const SectionIcon = icons[section as keyof typeof icons] ?? TagDesign
---

<a
  href={`/proyectos/${slug}`}
  class="relative block w-fit snap-start"
  aria-label={`Ver proyecto: ${nameProject}`}
>
  <SectionIcon class="absolute right-4 -top-2 md:-top-3 w-14 sm:w-20 h-14 sm:h-20  z-40 drop-shadow-md" />
  <article
    class="group aspect-[4/3] h-full w-full max-w-xl flex flex-col border-2 border-black rounded-xl bg-white md:rounded-2xl overflow-hidden"
  >
    <div
      class="relative h-10 p-4 flex flex-row items-center border-b-4 border-black"
    >
      <div class="flex flex-row items-center gap-2">
        <div class="h-3 w-3 bg-black rounded-full"></div>
        <div class="h-3 w-3 bg-black rounded-full"></div>
        <div class="h-3 w-3 bg-black rounded-full"></div>
      </div>
      <p
        class="absolute left-1/2 -translate-x-1/2 text-sm text-primary font-bold"
      >
        {slug}
      </p>
    </div>
    <div
      class="relative flex flex-row gap-4 items-center justify-between p-4 flex-1"
    >
      <header
        class="border-2 border-black relative overflow-hidden md:flex-shrink-0 h-full w-1/2"
      >
        <Image
          src={coverImage}
          alt={'Portada del proyecto ' + nameProject}
          class=" w-full h-full object-cover object-center transition-transform duration-300 group-hover:scale-110"
          width={coverImage.width}
          height={coverImage.height}
        />
        <div class="absolute bottom-4 left-4 flex flex-wrap gap-2">
          {
            tags
              ?.slice(0, 1)
              .map(tag => (
                <div class="bg-secondary text-black border border-black py-0.5 px-2 md:px-4 w-fit text-xs font-semibold">
                  {tag}
                </div>
              ))
          }
        </div>
      </header>
      <main class="flex flex-col gap-2 xl:gap-6 flex-1">
        <div >
          <h4 class="text-xl md:text-2xl font-bold">
            {nameProject}
          </h4>
          <p
            class="text-lg lg:text-xl italic font-light font-fantabular opacity-75"
          >
            {projectType}
          </p>
        </div>
        <p class="text-sm lg:text-sm text-pretty line-clamp-4 leading-tight">
          {descriptionProject}
        </p>
        <div class="flex justify-end">
          <span
            aria-hidden="true"
            class="primaryButton py-2 px-4 text-xs sm:text-sm bg-white flex flex-row gap-2 text-left"
          >
            Ver proyecto
            <ArrowIcon aria-hidden="true" class="transition-transform ease-in-out duration-200 -rotate-45 group-hover:rotate-0 w-6" />
          </span>
        </div>
      </main>
    </div>
  </article>
</a>

<script>
  const button = document.getElementById('backToTop')

  button?.addEventListener('click', () => {
    window.scrollTo({
      top: 0,
      behavior: 'smooth',
    })
  })
</script>
