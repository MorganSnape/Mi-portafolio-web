---
// Logo de herramienta con el mismo estilo que los botones de redes
// (SocialMediaButtons): cuadro blanco de 40px con esquinas rounded-chico,
// logo oscuro centrado y un leve crecimiento al pasar el cursor.
// Lleva borde negro porque va sobre tarjetas claras: sin él, el cuadro blanco
// se pierde en el fondo crema (los de redes van sobre fondo oscuro).
const { logo: Logo, alt, text } = Astro.props

const isStringLogo = typeof Logo === 'string'
---

<div class="group/logo relative flex select-none">
  <span
    class="grid size-10 shrink-0 place-items-center rounded-chico border-2 border-black bg-white text-black-secondary transition-[scale,filter] duration-200 ease-in-out group-hover/logo:scale-105 group-hover/logo:brightness-90 motion-reduce:transition-none"
    role="img"
    aria-label={alt}
  >
    {
      Logo ? (
        isStringLogo ? (
          <img src={Logo} alt="" class="size-6 object-contain" />
        ) : (
          <Logo class="size-6" aria-hidden="true" />
        )
      ) : (
        <span class="font-fantabular text-base font-bold" aria-hidden="true">{text}</span>
      )
    }
  </span>

  <!-- Nombre de la herramienta al pasar el cursor (mismo estilo que la etiqueta del menú) -->
  <span
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-full z-20 mt-2 -translate-x-1/2 -translate-y-1 whitespace-nowrap rounded-chico bg-black px-3 py-1 text-xs font-semibold text-white-cream opacity-0 transition-[opacity,translate] duration-150 group-hover/logo:translate-y-0 group-hover/logo:opacity-100"
  >
    {alt}
  </span>
</div>
