---
type StyleType = "transparent" | "solid";

interface Props {
  id?: string;
  style: StyleType;
  text?: string;
  typeIcon?: boolean;
  href: string;
}

const { style, text, typeIcon, href, id } = Astro.props;

// Sólido: morado con borde y sombra negros. Transparente: para fondos oscuros, borde y sombra blancos.
const variantes: Record<StyleType, string> = {
  solid: "bg-primary border-black",
  transparent: "bg-transparent border-white shadow-white",
};
---

<a
  id={id}
  href={href}
  class={`efecto-presionar border-2 text-white flex flex-row items-center gap-2 px-4 py-3 text-sm md:text-base font-normal ${variantes[style]}`}
>
  {text && <span>{text}</span>}
  {typeIcon &&<span class="flex items-center stroke-white"><slot/></span> }
</a>
