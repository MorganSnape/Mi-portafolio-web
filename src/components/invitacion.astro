---
import Icon from 'node_modules/astro-icon/components/Icon.astro'
import Button from './Button.astro'

const { class: className } = Astro.props
---

<div class={`w-full bg-primary text-white ${className}`}>
  <section
    class="flex flex-col gap-8 max-w-[1280px] mx-auto px-4 py-16 md:px-12 md:py-16 lg:px-0 sm:px-12 xl:px-0"
    aria-labelledby="contact-invitation-title"
  >
    <h2
      id="contact-invitation-title"
      class="max-w-4xl font-fantabular text-4xl italic leading-none md:text-4xl"
    >
      Hagamos realidad tu próxima idea
    </h2>
    <div class="flex flex-col gap-6">
      <p class="max-w-2xl leading-relaxed md:text-lg">
        ¿Tienes un proyecto en mente? Cuéntame qué necesitas y encontremos
        juntos la mejor forma de construirlo.
      </p>
      <Button
        href="/contactame"
        text="Hablemos de tu proyecto"
        style="transparent"
        typeIcon
      >
        <Icon name="fa6-solid:arrow-right" height={18} width={18} />
      </Button>
    </div>
  </section>
</div>
