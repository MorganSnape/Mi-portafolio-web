---
// Invitación al final de cada página del portafolio, con el estilo del Cierre del blog:
// tarjeta negra, título rosa en Fantabular, enlaces en píldora y dos Onduladas.
// Sin props muestra el texto del portafolio.
import Cierre from '@/components/ui/Cierre.astro'

interface Enlace {
  texto: string
  href: string
}

interface Props {
  class?: string
  /** Usa "\n" para partir el título en dos líneas */
  titulo?: string
  texto?: string
  enlaces?: Enlace[]
}

const {
  class: className = '',
  titulo = 'Hagamos realidad\ntu próxima idea',
  texto = '¿Tienes un proyecto en mente? Cuéntame qué necesitas y encontremos juntos la mejor forma de construirlo.',
  enlaces = [
    { texto: 'Hablemos de tu proyecto', href: '/contactame' },
    { texto: 'Ver mis proyectos', href: '/#proyectos-container' },
  ],
} = Astro.props
---

<!-- Ocupa todo el ancho que le dé su contenedor: no pone márgenes laterales
     ni ancho propio. La página decide el ancho (ver index.astro y sobre-mi.astro). -->
<div class:list={['w-full pt-16 md:pt-20 pb-10', className]}>
  <Cierre titulo={titulo} texto={texto} enlaces={enlaces} />
</div>
