---
import type { Studies } from "@/models";

import IconMedioCirculo from "@/icons/medio-circulo.svg";
import Etiqueta from "@/components/ui/Etiqueta.astro";

interface Props extends Studies {}

const { title, descriptions, institution, duration, logo } =
  Astro.props;
---

<article
  class="relative flex flex-col h-full w-full overflow-hidden rounded-ventana border-2 border-black bg-white-cream shadow-dura"
>
  <div class="relative flex flex-col justify-between gap-3 p-6 flex-1">
    <div class="flex-1 flex flex-col gap-3">
      <!-- Siempre 2 líneas: reserva el alto de dos líneas (2lh) y corta con … si el título es más largo -->
      <h4 class="subtitulo min-h-[2lh] line-clamp-2 text-balance">
        {title}
      </h4>
      <Etiqueta color="amarillo" class="w-fit">{duration}</Etiqueta>

      <ul class="space-y-1 list-disc list-outside pl-4">
        {
          descriptions &&
            descriptions.map((description) => (
              <li class="text-sm lg:text-base text-black-secondary text-pretty">
                {description}
              </li>
            ))
        }
      </ul>
    </div>
    <div
      class="border-2 z-20 bg-white/90 border-gray-200 rounded-chico w-fit px-4 py-2 flex flex-row items-center gap-4"
    >
      <img
        src={logo}
        alt={`Logo de la institución ${institution}`}
        class="h-8 lg:h-12"
      />
      <p class="text-black font-normal text-sm font-fantabular italic">
        {institution}
      </p>
    </div>
    <IconMedioCirculo class="absolute -right-10 -bottom-10 w-1/4 opacity-40" />
  </div>
</article>
